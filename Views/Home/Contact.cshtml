@{
  ViewData["Title"] = "Liên hệ";
}

<div class="container py-5">
  <div class="text-center mb-5">
    <h2 style="font-family: var(--font-serif); color: var(--navy); font-weight: 500; letter-spacing: -0.01em; margin-bottom: 0.5rem;">Kết Nối Với Chúng Tôi</h2>
    <div style="width: 40px; height: 1px; background: var(--camel); margin: 0 auto;"></div>
  </div>

  <div class="row g-5 justify-content-center">
    <div class="col-lg-9">
      <div class="row g-5">
        @* Left Column: Contact details *@
        <div class="col-md-5">
          <h4 style="font-family: var(--font-serif); color: var(--navy); font-weight: 500; font-size: 1.25rem; margin-bottom: 1.25rem; letter-spacing: -0.01em;">
            Thông tin liên hệ
          </h4>
          <p class="text-muted mb-4" style="font-size: 0.88rem; line-height: 1.6;">
            Mọi yêu cầu hoặc thắc mắc của Quý khách sẽ được tiếp nhận và phản hồi chu đáo bởi đội ngũ chăm sóc khách hàng hoặc Trợ lý Concierge AI.
          </p>

          <div class="contact-info-list">
            <div class="contact-info-item">
              <div class="contact-icon"><i class="far fa-compass"></i></div>
              <div>
                <div class="contact-item-title">Địa chỉ</div>
                <div class="contact-item-desc">475A Điện Biên Phủ, P.25, Q.Bình Thạnh, TP.HCM</div>
              </div>
            </div>
            
            <div class="contact-info-item">
              <div class="contact-icon"><i class="far fa-envelope"></i></div>
              <div>
                <div class="contact-item-title">Email</div>
                <div class="contact-item-desc">
                  <a href="mailto:info@hutechstore.com">info@hutechstore.com</a>
                </div>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-icon"><i class="far fa-comment-alt"></i></div>
              <div>
                <div class="contact-item-title">Trợ lý AI</div>
                <div class="contact-item-desc">
                  Giải đáp tức thì 24/7 —
                  <button onclick="toggleChat()" class="btn btn-link btn-sm p-0 fw-semibold" style="color: var(--camel-dark); font-size: 0.8rem; text-decoration: none;">
                    Mở Trợ lý
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        @* Right Column: Contact form *@
        <div class="col-md-7">
          <div class="contact-form-card">
            <h4 style="font-family: var(--font-serif); color: var(--navy); font-weight: 500; font-size: 1.25rem; margin-bottom: 1.5rem; letter-spacing: -0.01em;">
              Gửi yêu cầu
            </h4>
            
            <div id="contactSuccess" class="contact-success-alert d-none">
              <i class="far fa-check-circle me-2"></i>Cảm ơn Quý khách! Thông điệp đã được gửi thành công.
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="luxury-label">Họ tên</label>
                <input type="text" class="form-control luxury-input" id="cName" placeholder="Nguyễn Văn A"/>
              </div>
              <div class="col-md-6">
                <label class="luxury-label">Email</label>
                <input type="email" class="form-control luxury-input" id="cEmail" placeholder="your@email.com"/>
              </div>
              <div class="col-12">
                <label class="luxury-label">Tiêu đề</label>
                <input type="text" class="form-control luxury-input" id="cSubject" placeholder="Tôi muốn hỏi về..."/>
              </div>
              <div class="col-12">
                <label class="luxury-label">Nội dung</label>
                <textarea class="form-control luxury-input" id="cMessage" rows="4" placeholder="Nội dung tin nhắn..."></textarea>
              </div>
              <div class="col-12 mt-4">
                <button class="btn btn-luxury-primary px-4 py-2" onclick="submitContact()" style="width: auto; font-size: 0.8rem; border-radius: 20px;">
                  Gửi thông điệp
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Styles {
<style>
  .contact-info-list { 
    display: flex; 
    flex-direction: column; 
    gap: 1.5rem; 
  }
  .contact-info-item { 
    display: flex; 
    align-items: flex-start; 
    gap: 1rem; 
  }
  .contact-icon { 
    width: 40px; 
    height: 40px; 
    border-radius: 50%; 
    background: var(--ivory-warm); 
    color: var(--camel-dark); 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    flex-shrink: 0; 
    font-size: 1.05rem; 
    border: 1px solid rgba(194, 178, 128, 0.12);
  }
  .contact-item-title {
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy);
    margin-bottom: 0.15rem;
  }
  .contact-item-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .contact-item-desc a {
    color: var(--navy);
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-item-desc a:hover {
    color: var(--camel-dark);
  }

  .contact-form-card { 
    background: var(--ivory-pure); 
    border-radius: 12px; 
    border: 1px solid rgba(194, 178, 128, 0.15); 
    padding: 2.25rem; 
    box-shadow: 0 4px 20px rgba(15, 42, 68, 0.01); 
  }

  /* Form labels */
  .luxury-label {
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: var(--text-muted) !important;
    margin-bottom: 0.35rem !important;
    font-family: var(--font-sans) !important;
    display: inline-block;
  }

  /* Luxury Form inputs */
  .luxury-input {
    background-color: var(--ivory-warm) !important;
    border: 1px solid rgba(15, 42, 68, 0.08) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    padding: 0.7rem 0.9rem !important;
    border-radius: 6px !important;
    color: var(--navy) !important;
    transition: all 0.3s var(--ease-luxury) !important;
    box-shadow: none !important;
  }
  .luxury-input::placeholder {
    color: var(--text-tertiary) !important;
    opacity: 0.7;
  }
  .luxury-input:focus {
    background-color: var(--ivory-pure) !important;
    border-color: var(--camel) !important;
    box-shadow: none !important;
    outline: none !important;
  }

  /* Custom success alert */
  .contact-success-alert {
    background: var(--ivory-pure);
    border: 1px solid rgba(40, 167, 69, 0.25);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: #28a745;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
</style>
}

@section Scripts {
<script>
  function submitContact() {
    const name = document.getElementById('cName').value.trim();
    const email = document.getElementById('cEmail').value.trim();
    const subject = document.getElementById('cSubject').value.trim();
    const msg  = document.getElementById('cMessage').value.trim();
    
    if (!name || !msg) { 
      showToast('Vui lòng điền đầy đủ họ tên và nội dung tin nhắn', 'error'); 
      return; 
    }
    
    document.getElementById('contactSuccess').classList.remove('d-none');
    ['cName','cEmail','cSubject','cMessage'].forEach(id => document.getElementById(id).value = '');
    
    if (typeof showToast === 'function') {
      showToast('Thông điệp của bạn đã được tiếp nhận', 'success');
    }
  }
</script>
}
