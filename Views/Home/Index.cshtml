@* ══════════════════════════════════════════════════════════════════
   SECTION 8 — AI CONCIERGE · Tư Vấn Thông Minh
   ══════════════════════════════════════════════════════════════════ *@
<section class="ai-concierge-section">
  <div class="ambient-glow"></div>
  <div class="container position-relative" style="z-index:2;">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8">
        <div class="ai-lounge-badge">AI CONCIERGE</div>
        <h3 class="mb-3 text-white fw-light" style="letter-spacing: 0.08em; font-family: var(--font-serif);">
          TRÌNH TƯ VẤN THÔNG MINH
        </h3>
        <p class="text-white opacity-75 mb-4" style="font-size: 1rem; line-height: 1.7; font-weight: 300;">
          Hãy chia sẻ nhu cầu, ngân sách hoặc sở thích sử dụng của bạn.
          Trợ lý AI cao cấp của chúng tôi sẽ đề xuất thiết bị tối ưu và phù hợp nhất.
        </p>
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
          <span class="ai-chip-clean" onclick="openChatWithText('Tìm máy chơi game mượt mà dưới 15 triệu')">Cấu hình chơi game</span>
          <span class="ai-chip-clean" onclick="openChatWithText('Gợi ý điện thoại chụp ảnh đẹp nhất hiện nay')">Chụp ảnh chuyên nghiệp</span>
          <span class="ai-chip-clean" onclick="openChatWithText('Tư vấn dòng máy cao cấp tầm giá 20-30 triệu')">Phân khúc cao cấp</span>
          <span class="ai-chip-clean" onclick="openChatWithText('So sánh iPhone 17 Pro Max và Galaxy S25 Ultra')">So sánh Flagship</span>
        </div>
        <button class="btn-luxury-gold-clean" onclick="toggleChat()">
          BẮT ĐẦU TRÒ CHUYỆN
        </button>
      </div>
    </div>
  </div>
</section>

@* ── SECTION: LUCKY WHEEL EVENT (QUIET LUXURY REDESIGN) ── *@
<section class="minigame-banner-section py-5" style="background: var(--ivory-warm); border-top: 1px solid rgba(194, 178, 128, 0.15); border-bottom: 1px solid rgba(194, 178, 128, 0.15);">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <div class="p-3" style="border-left: 2px solid var(--camel);">
          <span class="editorial-tag" style="letter-spacing: 0.15em;">ĐẶC QUYỀN MUA SẮM</span>
          <h2 class="font-serif fw-light text-navy mt-2 mb-3" style="font-size: 2.2rem; letter-spacing: 0.02em; line-height: 1.3;">
            VÒNG XOAY MAY MẮN &<br/>
            KHẢO SÁT Ý KIẾN KHÁCH HÀNG
          </h2>
          <p class="text-muted mb-4" style="font-size: 0.95rem; line-height: 1.7; font-weight: 300;">
            Dành 1 phút chia sẻ cảm nhận của bạn về HutechStore để nhận ngay 1 lượt quay 
            may mắn với cơ hội trúng các mã giảm giá đặc quyền lên tới <strong>1,000,000₫</strong> 
            và hàng ngàn phần quà giá trị khác.
          </p>
          <a asp-controller="Minigame" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 30px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">
            THAM GIA VÒNG XOAY
          </a>
        </div>
      </div>
      <div class="col-lg-6 text-center">
        <div class="position-relative d-inline-block p-4">
          @* Minimalist abstract wheel representation using CSS *@
          <div class="wheel-promo-art" style="width: 280px; height: 280px; border-radius: 50%; border: 3px solid var(--camel); position: relative; margin: 0 auto; background: var(--ivory-pure); box-shadow: 0 12px 32px rgba(15, 42, 68, 0.05); display: flex; align-items: center; justify-content: center; animation: spinSlow 30s linear infinite;">
            <div style="position: absolute; width: 100%; height: 1px; background: rgba(194, 178, 128, 0.25); transform: rotate(0deg);"></div>
            <div style="position: absolute; width: 100%; height: 1px; background: rgba(194, 178, 128, 0.25); transform: rotate(45deg);"></div>
            <div style="position: absolute; width: 100%; height: 1px; background: rgba(194, 178, 128, 0.25); transform: rotate(90deg);"></div>
            <div style="position: absolute; width: 100%; height: 1px; background: rgba(194, 178, 128, 0.25); transform: rotate(135deg);"></div>
            <div style="width: 240px; height: 240px; border-radius: 50%; border: 1px solid rgba(194, 178, 128, 0.15); background: var(--ivory-warm); display: flex; align-items: center; justify-content: center;">
              <div style="width: 180px; height: 180px; border-radius: 50%; border: 2px dashed var(--camel); background: var(--ivory-pure); display: flex; align-items: center; justify-content: center;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--navy); border: 2px solid var(--camel);"></div>
              </div>
            </div>
          </div>
          @* Pointer *@
          <div style="position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 14px solid transparent; border-right: 14px solid transparent; border-top: 24px solid var(--camel); z-index: 5;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
<script>
  function openChatWithText(text) {
    if (!chatOpen) toggleChat();
    setTimeout(() => {
      const input = document.getElementById('chatInput');
      if (input) {
        input.value = text;
        sendMessage();
      }
    }, 300);
  }

  // ══════════════════════════════════════════════════════════════
  // INTERSECTION OBSERVER — Play Once on Scroll for Story Videos
  // ══════════════════════════════════════════════════════════════
  document.addEventListener('DOMContentLoaded', () => {
    // Select all videos with data-play-once attribute (story & hero videos)
    const playOnceVideos = document.querySelectorAll('video[data-play-once="true"]');
    
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target;
        
        if (entry.isIntersecting && entry.intersectionRatio >= 0.25) {
          // Only play if not already finished
          if (!video.dataset.finished) {
            video.play().catch(() => {});
          }
        } else {
          // Pause when scrolled out of view (but don't mark as finished)
          if (!video.paused && !video.ended) {
            video.pause();
          }
        }
      });
    }, { threshold: 0.25 });

    playOnceVideos.forEach(video => {
      // When video ends, mark it as finished so it never replays
      video.addEventListener('ended', () => {
        video.dataset.finished = 'true';
      });
      
      videoObserver.observe(video);
    });

    // ══════════════════════════════════════════════════════════════
    // SAMSUNG VIDEO CAROUSEL — Plays Once Per Slide, Stops at Slide 5
    // ══════════════════════════════════════════════════════════════
    const sliderTrack = document.getElementById('samsungSliderTrack');
    const slides = document.querySelectorAll('.samsung-slide');
    const tabs = document.querySelectorAll('.samsung-nav-tab');
    const videos = document.querySelectorAll('.samsung-slide-video');
    
    let currentSlide = 0;
    let animationFrameId = null;
    let carouselFinished = false;

    // Samsung Carousel IntersectionObserver — only start first video when carousel is visible
    const carouselSection = document.querySelector('.samsung-carousel-section');
    let carouselStarted = false;

    const carouselObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !carouselStarted) {
          carouselStarted = true;
          playVideo(0);
        }
      });
    }, { threshold: 0.3 });

    if (carouselSection) {
      carouselObserver.observe(carouselSection);
    }

    function initSlider() {
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          if (carouselFinished && index === slides.length - 1) return;
          carouselFinished = false;
          goToSlide(index);
        });
      });
    }

    function playVideo(index) {
      // Pause all other videos
      videos.forEach((vid, i) => {
        if (i !== index) {
          vid.pause();
          vid.currentTime = 0;
        }
      });

      const activeVid = videos[index];
      if (activeVid) {
        activeVid.currentTime = 0;
        activeVid.muted = true;
        const playPromise = activeVid.play();
        if (playPromise !== undefined) {
          playPromise.catch(error => {
            console.log("Autoplay block: ", error);
          });
        }

        // Track progress
        startProgressTracking(activeVid, index);
      }
    }

    function startProgressTracking(video, index) {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);

      // Reset all fills
      document.querySelectorAll('.tab-progress-fill').forEach(fill => {
        fill.style.width = '0%';
      });

      const activeFill = tabs[index].querySelector('.tab-progress-fill');

      function updateProgress() {
        if (video.duration) {
          const pct = (video.currentTime / video.duration) * 100;
          if (activeFill) {
            activeFill.style.width = `${pct}%`;
          }
        }
        
        if (!video.paused && !video.ended) {
          animationFrameId = requestAnimationFrame(updateProgress);
        }
      }

      animationFrameId = requestAnimationFrame(updateProgress);

      // Transition to next slide when current video ends
      video.onended = () => {
        if (activeFill) activeFill.style.width = '100%';
        
        const nextIndex = index + 1;
        
        // If this is the LAST slide (index 4), STOP — do not loop back
        if (nextIndex >= slides.length) {
          carouselFinished = true;
          if (animationFrameId) cancelAnimationFrame(animationFrameId);
          return; // Stop carousel completely
        }
        
        // Otherwise, transition to next slide after a small delay
        setTimeout(() => {
          goToSlide(nextIndex);
        }, 400);
      };
    }

    function goToSlide(index) {
      if (index === currentSlide) return;

      tabs.forEach(t => t.classList.remove('active'));
      tabs[index].classList.add('active');

      if (sliderTrack) {
        sliderTrack.style.transform = `translate3d(-${index * 100}%, 0, 0)`;
      }

      currentSlide = index;
      playVideo(index);
    }

    initSlider();
  });
</script>
}
