@{
  ViewData["Title"] = "Luxury Boutique";
  ViewData["HeaderTransparent"] = true;
  var featured  = ViewBag.Featured  as List<HutechStore.Models.Product> ?? new();
  var iphones   = ViewBag.IPhones   as List<HutechStore.Models.Product> ?? new();
  var samsungs  = ViewBag.Samsungs  as List<HutechStore.Models.Product> ?? new();
}

@* ══════════════════════════════════════════════════════════════════
   SECTION 1 — CINEMATIC VIDEO HERO · iPhone Air
   "Bán câu chuyện, không bán sản phẩm"
   ══════════════════════════════════════════════════════════════════ *@
<section class="hero-video-banner">
  <video muted playsinline poster="/images/banner/Apple-iPhone-Air-hero-250909_big.jpg.large_2x.jpg" data-play-once="true">
    <source src="/images/ip_air_details/Apple-iPhone-Air-plateau-250909.mp4" type="video/mp4"/>
  </video>
  <div class="hero-video-overlay"></div>
  <div class="hero-video-content">
    <div class="luxury-slogan">CHẾ TÁC DI SẢN · 2025</div>
    <h1>
      IPHONE AIR.<br/>
      <strong>NHẸ TỰA HƯ VÔ.</strong>
    </h1>
    <p class="hero-tagline">
      Khi công nghệ biến mất, chỉ còn lại sự thuần khiết tối thượng.
      Định hình ngôn ngữ Quiet Luxury mới với thiết kế siêu mỏng chưa từng có.
    </p>
    <div class="hero-cta-group">
      <a asp-controller="Product" asp-action="Detail" asp-route-id="iphone-air" class="btn-hero-glass primary">
        KHÁM PHÁ CÂU CHUYỆN
      </a>
      <button class="btn-hero-glass secondary" onclick="toggleChat()">
        TƯ VẤN AI TRỰC TUYẾN
      </button>
    </div>
  </div>
  <div class="hero-scroll-hint">
    <span>KHÁM PHÁ</span>
    <div class="scroll-line"></div>
  </div>
</section>

@* ══════════════════════════════════════════════════════════════════
   SECTION 2 — THE ART OF TITANIUM · iPhone 17 Pro Max
   Editorial story: video + text asymmetric layout
   ══════════════════════════════════════════════════════════════════ *@
<section class="story-section dark">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <div class="story-media-wrap">
          <video muted playsinline data-play-once="true">
            <source src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-camera-Center-Stage-250909.mp4" type="video/mp4"/>
          </video>
          <span class="media-label">IPHONE 17 PRO MAX</span>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="story-eyebrow">KIẾN TRÚC TITANIUM CẤP ĐỘ 5</div>
        <h2 class="story-title">
          CHÚNG TÔI KHÔNG<br/>
          THIẾT KẾ THIẾT BỊ.<br/>
          CHÚNG TÔI <em>RÈN</em><br/>
          TÁC PHẨM.
        </h2>
        <p class="story-text">
          Với khung viền Forged Titanium tinh luyện qua nhiệt độ cao
          và hệ thống camera điện ảnh thế hệ mới, iPhone 17 Pro Max
          là biểu tượng cho những ai dẫn đầu và tôn sùng sự hoàn mỹ trong từng chi tiết.
        </p>
        <a asp-controller="Product" asp-action="Detail" asp-route-id="iphone-17-pro-max" class="btn-story-cta">
          KHÁM PHÁ CÂU CHUYỆN
        </a>
      </div>
    </div>
  </div>
</section>

@* ══════════════════════════════════════════════════════════════════
   SECTION 3 — THE PURENESS OF AIR · iPhone Air
   Editorial story: image + text (reversed layout)
   ══════════════════════════════════════════════════════════════════ *@
<section class="story-section light">
  <div class="container">
    <div class="row align-items-center g-5 flex-lg-row-reverse">
      <div class="col-lg-7">
        <div class="story-media-wrap">
          <video muted playsinline data-play-once="true">
            <source src="/images/ip_air_details/Apple-iPhone-Air-Ceramic-Shield-2-250909.mp4" type="video/mp4"/>
          </video>
          <span class="media-label">CERAMIC SHIELD 2</span>
        </div>
      </div>
      <div class="col-lg-5 pe-lg-5">
        <div class="story-eyebrow">SỰ TINH GIẢN TỐI THƯỢNG</div>
        <h2 class="story-title">
          QUIET LUXURY.<br/>
          MỎNG TỰA<br/>
          CÁNH BƯỚM.
        </h2>
        <p class="story-text">
          Sự sang trọng thực sự bắt nguồn từ những gì bạn không thể nhìn thấy.
          Bằng cách lược bỏ mọi chi tiết thừa thãi và tối ưu hóa độ dày chỉ tính bằng milimet,
          iPhone Air mang đến cảm giác cầm nắm thanh thoát chưa từng có.
        </p>
        <a asp-controller="Product" asp-action="Detail" asp-route-id="iphone-air" class="btn-story-cta">
          KHÁM PHÁ CÂU CHUYỆN
        </a>
      </div>
    </div>
  </div>
</section>

<hr class="section-divider"/>

@* ══════════════════════════════════════════════════════════════════
   SECTION 4 — CURATED COLLECTION: APPLE iPHONE
   Art Gallery Style
   ══════════════════════════════════════════════════════════════════ *@
@if (iphones.Any())
{
  <section class="story-section warm" style="padding-top: 5rem; padding-bottom: 5rem;">
    <div class="container">
      <div class="gallery-section-header">
        <div class="section-tag">BỘ SƯU TẬP TUYỂN CHỌN</div>
        <h2>APPLE iPHONE</h2>
        <p>
          Tuyển tập những tuyệt tác di động từ Apple — nơi hội tụ giữa công nghệ tiên phong
          và ngôn ngữ thiết kế tối giản đỉnh cao.
        </p>
      </div>
      <div class="row g-4 justify-content-center">
        @foreach (var p in iphones.Take(4))
        {
          <div class="col-6 col-md-4 col-lg-3">
            @await Html.PartialAsync("_ProductCard", p)
          </div>
        }
      </div>
      <div class="text-center mt-4">
        <a asp-controller="Product" asp-action="Index" asp-route-Brand="Apple" class="btn-story-cta">
          TẤT CẢ IPHONE →
        </a>
      </div>
    </div>
  </section>
}

