@{
  ViewData["Title"] = "Luxury Boutique";
  var featured  = ViewBag.Featured  as List<HutechStore.Models.Product> ?? new();
  var iphones   = ViewBag.IPhones   as List<HutechStore.Models.Product> ?? new();
  var samsungs  = ViewBag.Samsungs  as List<HutechStore.Models.Product> ?? new();
}

@* ── CINEMATIC HERO SECTION ── *@
<section class="hero-banner-luxury">
  <div class="hero-ambient-glow"></div>
  <div class="container relative">
    <div class="row justify-content-center text-center">
      <div class="col-lg-10">
        <div class="hero-content-boutique">
          <div class="luxury-slogan mb-3">BOUTIQUE SERIES 2026</div>
          <h1 class="hero-title-cinematic">
            QUYỀN LỰC TỐI GIẢN.<br/>
            <span class="text-camel-gold">ĐỊNH HÌNH VỊ THẾ.</span>
          </h1>
          <p class="hero-subtitle-cinematic">
            Nơi công nghệ đỉnh cao giao thoa cùng nghệ thuật chế tác tối giản. Khám phá các tuyệt tác di động xứng tầm vị thế của bạn.
          </p>
          <div class="hero-actions-luxury d-flex justify-content-center gap-3">
            <a asp-controller="Product" asp-action="Index" class="btn-luxury-action">
              KHÁM PHÁ CỬA HÀNG
            </a>
            <button class="btn-luxury-outline" onclick="toggleChat()">
              TRÒ CHUYỆN VỚI AI
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-scroll-indicator">
    <div class="mouse-scroll"></div>
  </div>
</section>

@* ── BRAND PROMOTIONS & CATEGORY SLIDERS ── *@

@* 1. APPLE IPHONE SECTION *@
@if (iphones.Any())
{
  <section class="py-5" style="background: var(--ivory-pure);">
    <div class="container">
      
      @* Category Promo Banner *@
      <div class="category-promo-banner apple-promo mb-4">
        <div class="promo-content">
          <span class="promo-eyebrow">APPLE FLAGSHIP</span>
          <h3 class="promo-title">iPhone 16 Pro Max</h3>
          <p class="promo-desc">Chế tác từ Titanium thế hệ mới. Apple Intelligence nâng tầm cuộc sống.</p>
          <a asp-controller="Product" asp-action="Index" asp-route-Brand="Apple" class="btn-promo-action">Khám Phá Dòng Máy</a>
        </div>
      </div>

      @* Category Title *@
      <div class="d-flex justify-content-between align-items-end mb-3 mt-5">
        <div>
          <h2 class="category-heading-title">IPHONE</h2>
          <div class="category-subheading">Sản phẩm Apple chính hãng mới nhất</div>
        </div>
        <a asp-controller="Product" asp-action="Index" asp-route-Brand="Apple" class="view-all-link">
          Xem tất cả iPhone
        </a>
      </div>

      @* Horizontal Slider Container *@
      <div class="slider-wrapper">
        <button class="slider-nav-btn prev-btn" onclick="slideContainer('iphone-slider', -1)" aria-label="Slide left">
          <i class="fas fa-chevron-left"></i>
        </button>
        <div class="luxury-slider-container" id="iphone-slider">
          <div class="slider-row">
            @foreach (var p in iphones)
            {
              <div class="slider-item">
                @await Html.PartialAsync("_ProductCard", p)
              </div>
            }
          </div>
        </div>
        <button class="slider-nav-btn next-btn" onclick="slideContainer('iphone-slider', 1)" aria-label="Slide right">
          <i class="fas fa-chevron-right"></i>
        </button>
      </div>

    </div>
  </section>
}

@* 2. SAMSUNG GALAXY SECTION *@
@if (samsungs.Any())
{
  <section class="py-5" style="background: var(--ivory-warm); border-top: 1px solid rgba(194,178,128,0.1);">
    <div class="container">
      
      @* Category Promo Banner *@
      <div class="category-promo-banner samsung-promo mb-4">
        <div class="promo-content">
          <span class="promo-eyebrow">SAMSUNG FLAGSHIP</span>
          <h3 class="promo-title">Galaxy S25 Ultra</h3>
          <p class="promo-desc">Hiệu năng tối thượng cùng Snapdragon 8 Elite. Tích hợp bút S Pen quyền năng.</p>
          <a asp-controller="Product" asp-action="Index" asp-route-Brand="Samsung" class="btn-promo-action">Khám Phá Dòng Máy</a>
        </div>
      </div>

      @* Category Title *@
      <div class="d-flex justify-content-between align-items-end mb-3 mt-5">
        <div>
          <h2 class="category-heading-title">SAMSUNG GALAXY</h2>
          <div class="category-subheading">Đỉnh cao công nghệ và sáng tạo từ Samsung</div>
        </div>
        <a asp-controller="Product" asp-action="Index" asp-route-Brand="Samsung" class="view-all-link">
          Xem tất cả Samsung
        </a>
      </div>

      @* Horizontal Slider Container *@
      <div class="slider-wrapper">
        <button class="slider-nav-btn prev-btn" onclick="slideContainer('samsung-slider', -1)" aria-label="Slide left">
          <i class="fas fa-chevron-left"></i>
        </button>
        <div class="luxury-slider-container" id="samsung-slider">
          <div class="slider-row">
            @foreach (var p in samsungs)
            {
              <div class="slider-item">
                @await Html.PartialAsync("_ProductCard", p)
              </div>
            }
          </div>
        </div>
        <button class="slider-nav-btn next-btn" onclick="slideContainer('samsung-slider', 1)" aria-label="Slide right">
          <i class="fas fa-chevron-right"></i>
        </button>
      </div>

    </div>
  </section>
}

@* ── FEATURED PRODUCTS (ART GALLERY GRID) ── *@
@if (featured.Any())
{
  <section class="py-5" style="background: var(--ivory-pure);">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
          <h2 class="category-heading-title">SẢN PHẨM TIÊU BIỂU</h2>
          <div class="category-subheading">Tuyển chọn những thiết kế nổi bật được yêu thích nhất</div>
        </div>
        <a asp-controller="Product" asp-action="Index" class="view-all-link">
          Xem tất cả sản phẩm
        </a>
      </div>
      <div class="row g-4 justify-content-center">
        @foreach (var p in featured)
        {
          <div class="col-12 col-md-6 col-lg-4">
            @await Html.PartialAsync("_ProductCard", p)
          </div>
        }
      </div>
    </div>
  </section>
}

@* ── MINIMAL AI CONCIERGE BANNER ── *@
<section class="py-5" style="background: var(--navy-deep); position:relative; overflow:hidden;">
  <div class="hero-ambient-glow" style="opacity: 0.15;"></div>
  <div class="container">
    <div class="ai-concierge-lounge-clean p-5 text-center">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="ai-lounge-badge mb-3">AI CONCIERGE</div>
          <h3 class="mb-3 text-white fw-light" style="letter-spacing: 0.05em; font-family: 'Cinzel', serif;">TRÌNH TƯ VẤN THÔNG MINH</h3>
          <p class="text-white opacity-75 mb-4" style="font-size: 1.05rem; line-height: 1.6;">
            Hãy chia sẻ nhu cầu, ngân sách hoặc sở thích sử dụng của bạn. Trợ lý AI cao cấp của chúng tôi sẽ đề xuất thiết bị tối ưu và phù hợp nhất.
          </p>
          <div class="ai-chips d-flex justify-content-center flex-wrap gap-2 mb-4">
            <span class="ai-chip-clean" onclick="openChatWithText('Tìm máy chơi game mượt mà dưới 15 triệu')">Cấu hình chơi game</span>
            <span class="ai-chip-clean" onclick="openChatWithText('Gợi ý điện thoại chụp ảnh đẹp nhất hiện nay')">Chụp ảnh chuyên nghiệp</span>
            <span class="ai-chip-clean" onclick="openChatWithText('Tư vấn dòng máy cao cấp tầm giá 20-30 triệu')">Phân khúc cao cấp</span>
            <span class="ai-chip-clean" onclick="openChatWithText('So sánh sự khác nhau giữa iOS và Android')">iOS vs Android</span>
          </div>
          <button class="btn-luxury-gold-clean px-5 py-3" onclick="toggleChat()">
            BẮT ĐẦU TRÒ CHUYỆN
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
<script>
  // Slide horizontal container
  function slideContainer(containerId, direction) {
    const container = document.getElementById(containerId);
    if (container) {
      const scrollAmount = container.clientWidth * 0.75;
      container.scrollBy({
        left: direction * scrollAmount,
        behavior: 'smooth'
      });
    }
  }

  function openChatWithText(text) {
    if (!chatOpen) toggleChat();
    setTimeout(() => {
      const input = document.getElementById('chatInput');
      if (input) {
        input.value = text;
        sendMessage();
      }
    }, 300);
  }
</script>
}
