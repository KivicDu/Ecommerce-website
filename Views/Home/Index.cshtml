          </div>
        </div>
      </div>

    </div>

    <!-- Navigation Tabs with progress -->
    <div class="samsung-carousel-nav" id="samsungCarouselNav">
      <button class="samsung-nav-tab active" data-slide="0">
        <span class="samsung-nav-tab-label">TÍNH NĂNG 01</span>
        <span class="samsung-nav-tab-title">Thiết Kế Mỏng Nhẹ</span>
        <div class="tab-progress-track"><div class="tab-progress-fill"></div></div>
