      <button class="samsung-nav-tab" data-slide="1">
        <span class="samsung-nav-tab-label">TÍNH NĂNG 02</span>
        <span class="samsung-nav-tab-title">Trợ Lý Note AI</span>
        <div class="tab-progress-track"><div class="tab-progress-fill"></div></div>
      </button>
      <button class="samsung-nav-tab" data-slide="2">
        <span class="samsung-nav-tab-label">TÍNH NĂNG 03</span>
        <span class="samsung-nav-tab-title">Hiệu Năng Game</span>
        <div class="tab-progress-track"><div class="tab-progress-fill"></div></div>
      </button>
      <button class="samsung-nav-tab" data-slide="3">
        <span class="samsung-nav-tab-label">TÍNH NĂNG 04</span>
        <span class="samsung-nav-tab-title">Màn Hình Gập Flex</span>
        <div class="tab-progress-track"><div class="tab-progress-fill"></div></div>
      </button>
      <button class="samsung-nav-tab" data-slide="4">
        <span class="samsung-nav-tab-label">TÍNH NĂNG 05</span>
        <span class="samsung-nav-tab-title">FlexCam Tự Động</span>
        <div class="tab-progress-track"><div class="tab-progress-fill"></div></div>
