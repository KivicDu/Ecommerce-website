          </div>
        </div>
      </div>

      <!-- Slide 5: FlexCam -->
      <div class="samsung-slide">
        <video class="samsung-slide-video" muted playsinline data-index="4">
          <source src="/images/banner/galaxy-z-fold6-features-highlights-cts.webm" type="video/webm"/>
        </video>
        <div class="samsung-slide-overlay">
          <div class="samsung-slide-content">
            <div class="samsung-slide-eyebrow">FLEXCAM AUTO ZOOM · CHỤP HÌNH KHÔNG CHẠM</div>
            <h2 class="samsung-slide-title">GÓC CHỤP LINH HOẠT.<br/>TỰ ĐỘNG THU <em>PHÓNG.</em></h2>
            <p class="samsung-slide-text">
