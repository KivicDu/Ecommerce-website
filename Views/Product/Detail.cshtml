@model HutechStore.ViewModels.ProductDetailViewModel
@{
  ViewData["Title"] = Model.Product.Name;
  var p       = Model.Product;
  var specs   = p.PhoneSpecs;
  var variants = p.ProductVariants.Where(v => v.Status == 1).ToList();
  var images   = p.ProductImages.OrderBy(i => i.SortOrder).ToList();
  var mainImg  = images.FirstOrDefault(i => i.IsMain)?.ImageUrl
              ?? images.FirstOrDefault()?.ImageUrl
              ?? p.Image
              ?? "/images/no-image.png";
  var inStock  = p.Stock > 0 || variants.Any(v => v.Stock > 0);

  // Lấy danh sách màu sắc của sản phẩm
  var colors = variants.Any(v => !string.IsNullOrEmpty(v.Color))
      ? variants.Where(v => !string.IsNullOrEmpty(v.Color)).Select(v => v.Color!).Distinct().ToList()
      : (specs != null && !string.IsNullOrEmpty(specs.Colors)
          ? specs.Colors.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(c => c.Trim()).ToList()
          : new List<string> { "Mặc định" });
}

<div class="container py-4">

  @* ── BREADCRUMB ── *@
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb luxury-breadcrumb">
      <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
      <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
      @if (p.Category != null)
      {
        <li class="breadcrumb-item">
          <a asp-controller="Product" asp-action="Index" asp-route-Category="@p.CategoryId">
            @p.Category.Name
          </a>
        </li>
      }
      <li class="breadcrumb-item active text-truncate" style="max-width:200px">@p.Name</li>
    </ol>
  </nav>

  @* ── MAIN DETAIL SECTION: APPLE-STYLE BUY FLOW ── *@
  <div class="buy-flow-layout mb-5">
    <div class="buy-flow-grid">
      
      @* ── LEFT COLUMN (STICKY GALLERY) ── *@
      <div class="buy-flow-left">
        <div class="buy-flow-gallery-viewport">
          <img id="mainImage" src="@mainImg" alt="@p.Name" class="buy-flow-main-image"/>
          <img id="mainImageTemp" src="" alt="" class="buy-flow-main-image" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; padding: 0.8rem; opacity: 0; transition: opacity 0.3s ease; pointer-events: none;"/>
          
          <button class="wishlist-btn-clean @(Model.InWishlist ? "active" : "")"
                  onclick="toggleWishlist(@p.Id, this)"
                  title="@(Model.InWishlist ? "Bỏ yêu thích" : "Thêm yêu thích")"
                  style="position: absolute; top: 20px; right: 20px;">
            <i class="@(Model.InWishlist ? "fas" : "far") fa-heart"></i>
          </button>
        </div>
      </div>

      @* ── RIGHT COLUMN (SCROLLING CONFIGURATION) ── *@
      <div class="buy-flow-right">
        
        @* Intro Headers *@
        <div class="buy-flow-intro">
          <div class="buy-flow-brand-tag">
            @(p.Brand == "Apple" ? "Sản phẩm Apple" : "Sản phẩm Samsung")
          </div>
          <h1 class="buy-flow-product-name">@p.Name</h1>
          
          @* Rating review count *@
          <div class="d-flex align-items-center gap-2 mt-2">
            <div class="text-warning small">
              @for (int i = 1; i <= 5; i++)
              {
                <i class="@(i <= (int)Math.Round(Model.AvgRating) ? "fas" : "far") fa-star"></i>
              }
            </div>
            <span class="text-muted small">
              @Model.AvgRating.ToString("0.0") (@p.Reviews.Count đánh giá)
            </span>
          </div>
        </div>

        @* ── STEP 1: SELECT COLOR ── *@
        <div class="buy-flow-step active" id="colorStep">
          <span class="buy-flow-step-num">Bước 01</span>
          <h3 class="buy-flow-step-header">Màu sắc. <em>Chọn màu yêu thích.</em></h3>
          <p class="buy-flow-step-desc">Sắc màu thời thượng được tinh luyện bền bỉ.</p>
          
          <div class="buy-flow-color-grid">
            @foreach (var c in colors)
            {
              var hexColor = GetHexForColorName(c);
              <button type="button" 
                      class="buy-flow-color-pill" 
                      data-color="@c"
                      onclick="selectColor(this, '@c')"
                      title="@c">
                <div class="buy-flow-color-inner" style="background-color: @hexColor;"></div>
              </button>
            }
          </div>
          <span class="buy-flow-selected-color-text">Màu: <span id="selectedColorLabel" class="text-camel">Chưa chọn</span></span>
        </div>

        @* ── STEP 2: SELECT STORAGE ── *@
        <div class="buy-flow-step" id="storageStep">
          <span class="buy-flow-step-num">Bước 02</span>
          <h3 class="buy-flow-step-header">Dung lượng. <em>Bộ nhớ lưu trữ.</em></h3>
          <p class="buy-flow-step-desc">Dung lượng lưu trữ càng lớn, bạn càng lưu trữ được nhiều hình ảnh, video và ứng dụng.</p>
          
          <div class="buy-flow-storage-grid" id="storageGrid">
            @* Rendered dynamically by JavaScript *@
            <p class="text-muted small">Vui lòng chọn màu sắc trước để xem dung lượng tương ứng.</p>
          </div>
        </div>

        @* ── SUMMARY BOX & ADD TO CART ── *@
        <div class="buy-flow-summary-box">
          <div class="buy-flow-summary-info">
            <span class="buy-flow-summary-selection" id="summarySelectionText">Vui lòng chọn cấu hình sản phẩm</span>
            <span class="buy-flow-summary-price" id="displayPrice">@p.Price.ToString("N0")₫</span>
          </div>
          <button class="btn-buy-flow-submit locked" id="btnBuyFlowAdd" onclick="addToCartDetail(event)" disabled>
            Hoàn thành các bước chọn
          </button>
        </div>

        <div class="mt-3">
          <button type="button" class="btn btn-outline-navy w-100 d-flex align-items-center justify-content-center gap-2 py-2 fs-6" id="btnCompareProduct" onclick="openCompareModal()" style="border-radius: 30px; font-weight: 500; font-family: 'Inter', sans-serif; transition: all 0.3s ease; border: 1.5px solid var(--navy); color: var(--navy); background: transparent;">
            So sánh với các sản phẩm khác
          </button>
        </div>

      </div>

    </div>
  </div>

  @* ── TABS: DESCRIPTION / TECHNICAL SPECS / REVIEWS ── *@
  <div class="detail-tabs-clean mb-5">
    <ul class="nav nav-tabs-clean" id="detailTabs" role="tablist">
      <li class="nav-item">
        <button class="nav-link-clean active" data-bs-toggle="tab" data-bs-target="#tabDesc">
          Mô tả sản phẩm
        </button>
      </li>
      @if (specs != null)
      {
        <li class="nav-item">
          <button class="nav-link-clean" data-bs-toggle="tab" data-bs-target="#tabSpecs">
            Thông số kỹ thuật
          </button>
        </li>
      }
      <li class="nav-item">
        <button class="nav-link-clean" data-bs-toggle="tab" data-bs-target="#tabReviews">
          Nhận xét khách hàng (@p.Reviews.Count)
        </button>
      </li>
    </ul>

    <div class="tab-content tab-content-clean mt-3 p-4" style="background: var(--ivory-pure); border-radius: 12px; border: 1px solid rgba(194,178,128,0.12);">
      
      @* Tab: Description *@
      <div class="tab-pane fade show active" id="tabDesc">
        @if (p.Slug == "iphone-air")
        {
          @* iPhone Air Editorial Layout *@
          <div class="editorial-storyboard">
            
            <div class="editorial-hero mb-5">
              <video class="w-100 rounded-4 shadow-sm" autoplay muted loop playsinline style="max-height: 550px; object-fit: cover;">
                <source src="/images/ip_air_details/Apple-iPhone-Air-plateau-250909.mp4" type="video/mp4" />
              </video>
              <div class="editorial-caption text-center mt-3">
                <span class="editorial-tag">IPHONE AIR</span>
                <h2 class="editorial-headline text-navy mt-1">Nhẹ Tựa Hư Vô. Mỏng Đến Bất Ngờ.</h2>
                <p class="editorial-lead text-muted mx-auto" style="max-width: 750px;">
                  Độ mỏng ấn tượng chỉ bằng milimet, biến iPhone Air thành chiếc iPhone mỏng nhẹ nhất từng được chế tác, định hình lại triết lý Quiet Luxury của tương lai.
                </p>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(194, 178, 128, 0.08); border: 1px solid rgba(194, 178, 128, 0.15);">
                  <span class="editorial-tag">CERAMIC SHIELD 2</span>
                  <h3 class="fw-bold mt-2 text-navy">Bền bỉ gấp đôi</h3>
                  <p class="text-muted">
                    Dù sở hữu thân hình siêu mỏng, iPhone Air không hề mỏng manh. Được bao bọc bởi lớp kính Ceramic Shield thế hệ 2 mới nhất, máy mang lại khả năng chống trầy xước và va đập vượt trội so với mọi thế hệ trước.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_air_details/Apple-iPhone-Air-Ceramic-Shield-2-250909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5 flex-md-row-reverse">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(10, 30, 51, 0.03); border: 1px solid rgba(10, 30, 51, 0.08);">
                  <span class="editorial-tag">A19 CHIP & PERFORMANCE</span>
                  <h3 class="fw-bold mt-2 text-navy">Đồ họa console sống động</h3>
                  <p class="text-muted">
                    Bên trong kiến trúc mỏng nhẹ của iPhone Air là sức mạnh phần cứng vô song từ Chip A19 được tối ưu hóa. Cho phép chạy mượt mà các tựa game đồ họa console như Arknights: Endfield với hiệu ứng ánh sáng Ray Tracing rực rỡ và tốc độ khung hình cực kỳ ổn định.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_air_details/Apple-iPhone-Air-Gaming-Arknights-250909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(194, 178, 128, 0.08); border: 1px solid rgba(194, 178, 128, 0.15);">
                  <span class="editorial-tag">BATTERY LIFE</span>
                  <h3 class="fw-bold mt-2 text-navy">Năng lượng bền bỉ cả ngày</h3>
                  <p class="text-muted">
                    Thiết kế siêu mỏng đòi hỏi cấu trúc pin hoàn toàn mới. Công nghệ pin anode silicon mật độ năng lượng cao giúp iPhone Air hoạt động bền bỉ suốt ngày dài, đáp ứng mọi nhu cầu làm việc và giải trí không giới hạn.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_air_details/Apple-iPhone-Air-battery-250909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-4">
              <div class="col-md-6">
                <img src="/images/ip_air_details/Apple-iPhone-Air-iOS-Home-Screen-250909_inline.jpg.large_2x.jpg" class="w-100 rounded-4 shadow-sm" alt="iOS Home Screen" style="max-height: 350px; object-fit: cover;" />
              </div>
              <div class="col-md-6">
                <img src="/images/ip_air_details/Apple-iPhone-Air-48MP-250909_big.jpg.large_2x.jpg" class="w-100 rounded-4 shadow-sm" alt="Camera 48MP" style="max-height: 350px; object-fit: cover;" />
              </div>
            </div>

          </div>
        }
        else if (p.Slug == "iphone-17-pro-max" || p.Slug == "iphone-17-pro")
        {
          @* iPhone 17 Pro / Pro Max Editorial Layout *@
          <div class="editorial-storyboard">
            
            <div class="editorial-hero mb-5">
              <video class="w-100 rounded-4 shadow-sm" autoplay muted loop playsinline style="max-height: 550px; object-fit: cover;">
                <source src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-forged-plateau-250909.mp4" type="video/mp4" />
              </video>
              <div class="editorial-caption text-center mt-3">
                <span class="editorial-tag">IPHONE 17 PRO SERIES</span>
                <h2 class="editorial-headline text-navy mt-1">Forged Titanium. Đỉnh Cao Rèn Giũa.</h2>
                <p class="editorial-lead text-muted mx-auto" style="max-width: 750px;">
                  Sử dụng chất liệu Titanium Cấp 5 được tinh luyện tinh tế, kết hợp kiến trúc Forged Titanium hoàn toàn mới tạo nên một thiết kế vừa siêu nhẹ vừa cực kỳ bền bỉ.
                </p>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(194, 178, 128, 0.08); border: 1px solid rgba(194, 178, 128, 0.15);">
                  <span class="editorial-tag">CAMERA SYSTEM</span>
                  <h3 class="fw-bold mt-2 text-navy">Center Stage & Động năng điện ảnh</h3>
                  <p class="text-muted">
                    Hệ thống camera hoàn chỉnh với thuật toán Smart HDR mới và tính năng Center Stage cho phép bạn quay chụp tự động lấy nét và thu phóng thông minh, kiến tạo những thước phim điện ảnh đỉnh cao ngay trên tay.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-camera-Center-Stage-250909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5 flex-md-row-reverse">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(10, 30, 51, 0.03); border: 1px solid rgba(10, 30, 51, 0.08);">
                  <span class="editorial-tag">CONSOLE GAMING</span>
                  <h3 class="fw-bold mt-2 text-navy">Hiệu năng A19 Pro bức phá</h3>
                  <p class="text-muted">
                    Chip A19 Pro thế hệ mới tăng tốc xử lý đồ họa lên 30%, kết hợp khả năng dựng hình 3D mượt mà cho các game Console thế hệ tiếp theo như Arknights: Endfield. Tận hưởng đồ họa rực rỡ và chân thực chưa từng có.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-gaming-Arknights-Endfield-250909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(194, 178, 128, 0.08); border: 1px solid rgba(194, 178, 128, 0.15);">
                  <span class="editorial-tag">POWER & CONNECTIVITY</span>
                  <h3 class="fw-bold mt-2 text-navy">eSIM & Pin dung lượng cực khủng</h3>
                  <p class="text-muted">
                    Thiết kế tối ưu tối đa không gian vật lý bên trong nhờ công nghệ eSIM tích hợp, nhường chỗ cho khối pin dung lượng lớn hơn hẳn, mang lại thời lượng sử dụng vượt mọi mong đợi.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-esim-larger-battery-250909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-4">
              <div class="col-md-6">
                <img src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-iOS-26-Liquid-Glass-Lock-Screen-250909_inline.jpg.large_2x.jpg" class="w-100 rounded-4 shadow-sm" alt="Liquid Glass Screen" style="max-height: 350px; object-fit: cover;" />
              </div>
              <div class="col-md-6">
                <img src="/images/ip_17_promax_details/Apple-iPhone-17-Pro-Photographic-Styles-Bright-style-250909_big.jpg.large_2x.jpg" class="w-100 rounded-4 shadow-sm" alt="Photographic Styles" style="max-height: 350px; object-fit: cover;" />
              </div>
            </div>

          </div>
        }
        else if (p.Slug == "iphone-16" || p.Slug == "iphone-16-plus")
        {
          @* iPhone 16 / 16 Plus Editorial Layout *@
          <div class="editorial-storyboard">
            
            <div class="editorial-hero mb-5">
              <video class="w-100 rounded-4 shadow-sm" autoplay muted loop playsinline style="max-height: 550px; object-fit: cover;">
                <source src="/images/ip_16_details/Apple-iPhone-16-Ceramic-Shield-240909.mp4" type="video/mp4" />
              </video>
              <div class="editorial-caption text-center mt-3">
                <span class="editorial-tag">IPHONE 16 SERIES</span>
                <h2 class="editorial-headline text-navy mt-1">Độ bền vượt trội. Apple Intelligence.</h2>
                <p class="editorial-lead text-muted mx-auto" style="max-width: 750px;">
                  Sở hữu màn kính Ceramic Shield thế hệ mới cứng cáp nhất thế giới smartphone, đồng hành cùng vi xử lý A18 kiến tạo cho kỷ nguyên trí tuệ nhân tạo toàn năng.
                </p>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(194, 178, 128, 0.08); border: 1px solid rgba(194, 178, 128, 0.15);">
                  <span class="editorial-tag">APPLE INTELLIGENCE</span>
                  <h3 class="fw-bold mt-2 text-navy">Trợ lý Siri thế hệ mới & Writing Tools</h3>
                  <p class="text-muted">
                    Trải nghiệm Siri thông minh hiểu ngữ cảnh sâu rộng, kết hợp công cụ Writing Tools tự động biên tập văn bản, tóm tắt thông tin thông minh và tìm kiếm trực quan.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_16_details/Apple-iPhone-16-Apple-Intelligence-Writing-Tools-240909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5 flex-md-row-reverse">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(10, 30, 51, 0.03); border: 1px solid rgba(10, 30, 51, 0.08);">
                  <span class="editorial-tag">ACTION BUTTON</span>
                  <h3 class="fw-bold mt-2 text-navy">Tương tác nhanh với Action Button</h3>
                  <p class="text-muted">
                    Lần đầu tiên nút Tác Vụ (Action Button) xuất hiện trên phiên bản tiêu chuẩn, cho phép gán phím tắt nhanh kích hoạt ghi âm, đèn pin, camera hay bất kỳ phím tắt ưa thích nào.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_16_details/Apple-iPhone-16-Action-button-240909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
              <div class="col-md-6">
                <div class="p-4 rounded-4" style="background: rgba(194, 178, 128, 0.08); border: 1px solid rgba(194, 178, 128, 0.15);">
                  <span class="editorial-tag">GAMING POWER</span>
                  <h3 class="fw-bold mt-2 text-navy">Vi xử lý A18 đột phá hiệu năng</h3>
                  <p class="text-muted">
                    Sự tối ưu hóa phần cứng chip A18 mang lại khả năng xử lý mượt mà cho các tác vụ hàng ngày và các tựa game đồ họa console sống động, cho trải nghiệm giải trí không gián đoạn.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <video class="w-100 rounded-4" autoplay muted loop playsinline style="max-height: 320px; object-fit: cover;">
                  <source src="/images/ip_16_details/Apple-iPhone-16-gaming-240909.mp4" type="video/mp4" />
                </video>
              </div>
            </div>

            <div class="row g-4 align-items-center mb-4">
              <div class="col-md-6">
                <img src="/images/ip_16_details/Apple-iPhone-16-Camera-Control-01-240909_inline.jpg.large_2x.jpg" class="w-100 rounded-4 shadow-sm" alt="Camera Control" style="max-height: 350px; object-fit: cover;" />
