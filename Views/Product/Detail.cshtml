@model HutechStore.ViewModels.ProductDetailViewModel
@{
  ViewData["Title"] = Model.Product.Name;
  var p       = Model.Product;
  var specs   = p.PhoneSpecs;
  var variants = p.ProductVariants.Where(v => v.Status == 1).ToList();
  var images   = p.ProductImages.OrderBy(i => i.SortOrder).ToList();
  var mainImg  = images.FirstOrDefault(i => i.IsMain)?.ImageUrl
              ?? images.FirstOrDefault()?.ImageUrl
              ?? p.Image
              ?? "/images/no-image.png";
  var inStock  = p.Stock > 0 || variants.Any(v => v.Stock > 0);
}

<div class="container py-4">

  @* ── BREADCRUMB ── *@
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb luxury-breadcrumb">
      <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
      <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
      @if (p.Category != null)
      {
        <li class="breadcrumb-item">
          <a asp-controller="Product" asp-action="Index" asp-route-Category="@p.CategoryId">
            @p.Category.Name
          </a>
        </li>
      }
      <li class="breadcrumb-item active text-truncate" style="max-width:200px">@p.Name</li>
    </ol>
  </nav>

  @* ── MAIN DETAIL SECTION ── *@
  <div class="row g-4 mb-5">

    @* ── LEFT: IMAGE GALLERY VIEWPORT ── *@
    <div class="col-lg-5">
      <div class="detail-gallery">
        @* Main image *@
        <div class="detail-main-img-wrap-clean mb-3">
          <img id="mainImage" src="@mainImg" alt="@p.Name" class="detail-main-img-clean"/>
          
          <button class="wishlist-btn-clean @(Model.InWishlist ? "active" : "")"
                  onclick="toggleWishlist(@p.Id, this)"
                  title="@(Model.InWishlist ? "Bỏ yêu thích" : "Thêm yêu thích")">
            <i class="@(Model.InWishlist ? "fas" : "far") fa-heart"></i>
          </button>
        </div>

        @* Thumbnail strip *@
        @if (images.Count > 1)
        {
          <div class="detail-thumbs-clean">
            @foreach (var img in images)
            {
              <div class="detail-thumb-clean @(img.ImageUrl == mainImg ? "active" : "")"
                   onclick="switchImage('@img.ImageUrl', this)">
                <img src="@img.ImageUrl" alt="@p.Name thumbnail"/>
              </div>
            }
          </div>
        }
      </div>
    </div>

    @* ── RIGHT: INFO & CONTROLS ── *@
    <div class="col-lg-7">

      @* Brand & Status *@
      <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
        <div class="brand-badge-clean">
          @if (p.Brand == "Apple")
          {
            <span>Sản phẩm Apple</span>
          }
          else
          {
            <span>Sản phẩm Samsung</span>
          }
        </div>
        
        <div class="stock-status-clean">
          @if (inStock)
          {
            <span class="text-success fw-medium">Còn hàng</span>
          }
          else
          {
            <span class="text-muted fw-medium">Hết hàng</span>
          }
        </div>
      </div>

      <h1 class="detail-product-name-clean mb-2">@p.Name</h1>

      @* Rating *@
      <div class="detail-rating-row-clean mb-4">
        @for (int i = 1; i <= 5; i++)
        {
          <i class="@(i <= (int)Math.Round(Model.AvgRating) ? "fas" : "far") fa-star text-warning small"></i>
        }
        <span class="text-muted ms-2 small">
          @Model.AvgRating.ToString("0.0") (@p.Reviews.Count nhận xét)
        </span>
        @if (p.Featured == 1)
        {
          <span class="badge-featured-label ms-3">Sản Phẩm Tiêu Biểu</span>
        }
      </div>

      @* ── CONTROLS PANEL ── *@
      <div class="detail-control-panel-clean p-4 mb-4">
        
        @* Price display *@
        <div class="detail-price-wrap-clean mb-4 pb-3 border-bottom">
          <span class="detail-price-clean" id="displayPrice">@p.Price.ToString("N0")₫</span>
        </div>

        @* Variants (màu + dung lượng) *@
        @if (variants.Any())
        {
          @* Storage selector *@
          var storages = variants.Select(v => v.StorageGb).Distinct().OrderBy(s => s).ToList();
          @if (storages.Count > 1)
          {
            <div class="mb-3">
              <div class="variant-label-clean">Dung lượng bộ nhớ</div>
              <div class="variant-btn-group-clean" id="storageGroup">
                @foreach (var s in storages)
                {
                  var first = variants.First(v => v.StorageGb == s);
                  <button type="button"
                          class="variant-btn-clean"
                          data-storage="@s"
                          data-price="@first.Price"
                          data-variant-id="@first.Id"
                          onclick="selectVariant(this, 'storage')">
                    @s GB
                  </button>
                }
              </div>
            </div>
          }

          @* Color selector *@
          var colors = variants.Select(v => v.Color).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
          @if (colors.Count > 1)
          {
            <div class="mb-4">
              <div class="variant-label-clean">Màu sắc: <span id="selectedColor" class="fw-semibold text-camel"></span></div>
              <div class="variant-btn-group-clean" id="colorGroup">
                @foreach (var c in colors)
                {
                  var v = variants.First(vv => vv.Color == c);
                  <button type="button"
                          class="variant-btn-clean"
                          data-color="@c"
                          data-price="@v.Price"
                          data-variant-id="@v.Id"
                          onclick="selectVariant(this, 'color')">
                    @c
                  </button>
                }
              </div>
            </div>
          }
        }

        @* Quantity + Add to cart *@
        <div class="detail-actions-clean mb-2">
          <div class="qty-wrap-clean">
            <button type="button" class="qty-btn-clean" onclick="changeQty(-1)">−</button>
            <input type="number" id="qtyInput" value="1" min="1"
                   max="@(p.Stock > 0 ? p.Stock : 1)" class="qty-input-clean"/>
            <button type="button" class="qty-btn-clean" onclick="changeQty(1)">+</button>
          </div>
          
          <button class="btn btn-add-detail-clean flex-grow-1"
                  @(!inStock ? "disabled" : "")
                  onclick="addToCartDetail()">
            Thêm vào giỏ hàng
          </button>
          
          <button type="button"
                  class="btn btn-wishlist-detail-clean @(Model.InWishlist ? "active text-danger border-danger" : "")"
                  id="detailWishlistBtn"
                  onclick="toggleWishlist(@p.Id, this)"
                  title="@(Model.InWishlist ? "Bỏ yêu thích" : "Thêm yêu thích")">
            <i class="@(Model.InWishlist ? "fas" : "far") fa-heart"></i>
          </button>
        </div>
      </div>

      @* Brand Logistics Badges *@
      <div class="detail-badges-clean mb-4">
        <div class="detail-badge-clean-item">Miễn phí giao hàng toàn quốc từ 5 triệu</div>
        <div class="detail-badge-clean-item">Bảo hành chính hãng 12 tháng</div>
        <div class="detail-badge-clean-item">Hỗ trợ đổi trả trong vòng 30 ngày</div>
      </div>

      @* ── QUICK SPECS GRID ── *@
      @if (specs != null)
      {
        <div class="detail-quick-specs-clean p-4">
          <div class="qs-item-clean">
            <span class="qs-label-clean">Bộ vi xử lý</span>
            <span class="qs-value-clean">@specs.Chipset</span>
          </div>
          <div class="qs-item-clean">
            <span class="qs-label-clean">Bộ nhớ RAM</span>
            <span class="qs-value-clean">@specs.RamGb GB RAM</span>
          </div>
          <div class="qs-item-clean">
            <span class="qs-label-clean">Bộ nhớ trong</span>
            <span class="qs-value-clean">@specs.StorageGb GB ROM</span>
          </div>
          <div class="qs-item-clean">
            <span class="qs-label-clean">Màn hình</span>
            <span class="qs-value-clean">@specs.DisplaySize, @specs.RefreshRate Hz</span>
          </div>
        </div>
      }
    </div>
  </div>

  @* ── TABS: MÔ TẢ / THÔNG SỐ / ĐÁNH GIÁ ── *@
  <div class="detail-tabs-clean mb-5">
    <ul class="nav nav-tabs-clean" id="detailTabs" role="tablist">
      <li class="nav-item">
        <button class="nav-link-clean active" data-bs-toggle="tab" data-bs-target="#tabDesc">
          Mô tả sản phẩm
        </button>
      </li>
      @if (specs != null)
      {
        <li class="nav-item">
          <button class="nav-link-clean" data-bs-toggle="tab" data-bs-target="#tabSpecs">
            Thông số kỹ thuật
          </button>
        </li>
      }
      <li class="nav-item">
        <button class="nav-link-clean" data-bs-toggle="tab" data-bs-target="#tabReviews">
          Nhận xét khách hàng (@p.Reviews.Count)
        </button>
      </li>
    </ul>

    <div class="tab-content-clean mt-3 p-4">
      
      @* Tab: Mô tả *@
      <div class="tab-pane fade show active" id="tabDesc">
        @if (!string.IsNullOrEmpty(p.Description))
        {
          <div class="product-description-clean">@Html.Raw(p.Description)</div>
        }
        else
        {
          <p class="text-muted">Chưa có thông tin mô tả chi tiết cho sản phẩm này.</p>
        }
      </div>

      @* Tab: Thông số kỹ thuật *@
      @if (specs != null)
      {
        <div class="tab-pane fade" id="tabSpecs">
          <div class="specs-table-clean">
            <div class="specs-section-title-clean">Cấu hình & Bộ nhớ</div>
            <div class="specs-row-clean"><span>Vi xử lý (Chipset)</span><span>@specs.Chipset</span></div>
            <div class="specs-row-clean"><span>Bộ nhớ RAM</span><span>@specs.RamGb GB</span></div>
            <div class="specs-row-clean"><span>Bộ nhớ trong (ROM)</span><span>@specs.StorageGb GB</span></div>
            <div class="specs-row-clean"><span>Hệ điều hành</span><span>@specs.Os</span></div>

            <div class="specs-section-title-clean mt-4">Hệ thống Camera</div>
            <div class="specs-row-clean"><span>Camera sau</span><span>@specs.MainCamera</span></div>
            <div class="specs-row-clean"><span>Camera trước</span><span>@specs.FrontCamera</span></div>

            <div class="specs-section-title-clean mt-4">Màn hình hiển thị</div>
            <div class="specs-row-clean"><span>Kích thước</span><span>@specs.DisplaySize</span></div>
            <div class="specs-row-clean"><span>Công nghệ màn hình</span><span>@specs.DisplayType</span></div>
            <div class="specs-row-clean"><span>Tần số quét</span><span>@specs.RefreshRate Hz</span></div>

            <div class="specs-section-title-clean mt-4">Pin & Sạc</div>
            <div class="specs-row-clean"><span>Dung lượng Pin</span><span>@specs.BatteryMah mAh</span></div>
            <div class="specs-row-clean"><span>Sạc nhanh</span><span>@(specs.FastCharge ? "Có hỗ trợ sạc nhanh" : "Chuẩn thường")</span></div>
            <div class="specs-row-clean"><span>Sạc không dây</span><span>@(specs.WirelessCharge ? "Có hỗ trợ" : "Không")</span></div>

            <div class="specs-section-title-clean mt-4">Kết nối & Kích thước</div>
            <div class="specs-row-clean"><span>Kết nối 5G</span><span>@(specs.Has5G ? "Có hỗ trợ 5G" : "Không")</span></div>
            <div class="specs-row-clean"><span>Hỗ trợ NFC</span><span>@(specs.HasNfc ? "Có" : "Không")</span></div>
            <div class="specs-row-clean"><span>Kích thước</span><span>@specs.Dimensions</span></div>
            <div class="specs-row-clean"><span>Trọng lượng</span><span>@specs.WeightGrams g</span></div>
            <div class="specs-row-clean"><span>Màu sắc lựa chọn</span><span>@specs.Colors</span></div>
            <div class="specs-row-clean"><span>Năm ra mắt</span><span>@specs.ReleaseYear</span></div>
          </div>
        </div>
      }

      @* Tab: Đánh giá *@
      <div class="tab-pane fade" id="tabReviews">

        @* Rating summary *@
        @if (p.Reviews.Any())
        {
          <div class="review-summary-clean mb-4 border-bottom pb-3">
            <div class="review-avg-clean">
              <div class="review-avg-num-clean">@Model.AvgRating.ToString("0.1")</div>
              <div>
                @for (int i = 1; i <= 5; i++)
                {
                  <i class="@(i <= (int)Math.Round(Model.AvgRating) ? "fas" : "far") fa-star text-warning"></i>
                }
                <div class="text-muted small mt-1">Điểm đánh giá trung bình từ khách hàng</div>
              </div>
            </div>
          </div>
        }

        @* Review list *@
        @foreach (var r in p.Reviews.OrderByDescending(r => r.CreatedAt))
        {
          <div class="review-item-clean">
            <div class="review-header-clean">
              <div class="review-user-clean">
                <div class="review-avatar-clean">@(r.User?.Name.Substring(0, 1).ToUpper() ?? "?")</div>
                <div>
                  <div class="fw-semibold">@r.User?.Name</div>
                  <div class="text-muted small">Đăng ngày: @r.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
              </div>
              <div class="review-stars-clean">
                @for (int i = 1; i <= 5; i++)
                {
                  <i class="@(i <= r.Rating ? "fas" : "far") fa-star text-warning small"></i>
                }
              </div>
            </div>
            @if (!string.IsNullOrEmpty(r.Comment))
            {
              <p class="review-comment-clean mt-2">@r.Comment</p>
            }
          </div>
        }

        @if (!p.Reviews.Any())
        {
          <div class="text-center py-4 text-muted">
            <i class="far fa-comment-alt fa-2x mb-3 d-block"></i>
            Chưa có đánh giá nào cho sản phẩm này.
          </div>
        }

        @* Write review form *@
        @if (Model.IsLoggedIn)
        {
          <div class="review-form-wrap-clean mt-4 p-4">
            <h6 class="fw-bold mb-3">Gửi nhận xét của bạn</h6>
            <form asp-controller="Product" asp-action="AddReview" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="productId" value="@p.Id"/>
              
              <div class="mb-3">
                <label class="form-label fw-semibold small">Mức độ hài lòng</label>
                <div class="star-rating-clean">
                  @for (int i = 5; i >= 1; i--)
                  {
                    <input type="radio" name="rating" id="star@i" value="@i" required/>
                    <label for="star@i"><i class="fas fa-star"></i></label>
                  }
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold small">Ý kiến nhận xét</label>
                <textarea name="comment" class="form-control" rows="3"
                          placeholder="Chia sẻ nhận xét của bạn về sản phẩm này..."></textarea>
              </div>

              <button type="submit" class="btn btn-add-review-clean">
                Gửi Đánh Giá
              </button>
            </form>
          </div>
        }
        else
        {
          <div class="alert alert-light border mt-3 text-center py-3">
            Vui lòng <a asp-controller="Auth" asp-action="Login" class="text-camel fw-semibold">Đăng nhập</a> để viết đánh giá sản phẩm.
          </div>
        }
      </div>
    </div>
  </div>

  @* ── RELATED PRODUCTS ── *@
  @if (Model.Related.Any())
  {
    <div class="mb-5">
      <div class="mb-4 border-bottom pb-2">
        <h4 class="section-title">SẢN PHẨM TƯƠNG TỰ</h4>
      </div>
      <div class="row g-4">
        @foreach (var rp in Model.Related)
        {
          <div class="col-6 col-md-3">
            @await Html.PartialAsync("_ProductCard", rp)
          </div>
        }
      </div>
    </div>
  }

</div>

@* Hidden input for variant tracking *@
<input type="hidden" id="selectedVariantId" value=""/>

@section Scripts {
<script>
  let selectedVariantId = null;

  // Switch gallery image
  function switchImage(src, thumb) {
    const mainImgEl = document.getElementById('mainImage');
    mainImgEl.style.opacity = '0.3';
    setTimeout(() => {
      mainImgEl.src = src;
      mainImgEl.style.opacity = '1';
    }, 150);
    document.querySelectorAll('.detail-thumb-clean').forEach(t => t.classList.remove('active'));
    thumb?.classList.add('active');
  }

  // Select variant (storage / color)
  function selectVariant(btn, type) {
    const group = type === 'storage' ? 'storageGroup' : 'colorGroup';
    document.querySelectorAll(`#${group} .variant-btn-clean`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    selectedVariantId = btn.dataset.variantId;
    document.getElementById('selectedVariantId').value = selectedVariantId;

    const price = parseInt(btn.dataset.price);
    if (!isNaN(price)) {
      document.getElementById('displayPrice').textContent = price.toLocaleString('vi-VN') + '₫';
    }

    if (type === 'color') {
      const el = document.getElementById('selectedColor');
      if (el) el.textContent = btn.dataset.color;
    }
  }

  // Qty control
  function changeQty(delta) {
    const input = document.getElementById('qtyInput');
    const max   = parseInt(input.max) || 99;
    input.value = Math.max(1, Math.min(max, parseInt(input.value || 1) + delta));
  }

  // Add to cart from detail page
  function addToCartDetail() {
    const qty       = parseInt(document.getElementById('qtyInput').value) || 1;
    const variantId = selectedVariantId ? parseInt(selectedVariantId) : null;
    addToCart(@p.Id, null, variantId, qty);
  }

  // Auto-select first color variant on load
  const firstColorBtn = document.querySelector('#colorGroup .variant-btn-clean');
  if (firstColorBtn) selectVariant(firstColorBtn, 'color');
  const firstStorageBtn = document.querySelector('#storageGroup .variant-btn-clean');
  if (firstStorageBtn) selectVariant(firstStorageBtn, 'storage');
</script>
}
