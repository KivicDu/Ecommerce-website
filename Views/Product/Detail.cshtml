@functions {
  public static string GetHexForColorName(string? name)
  {
    if (string.IsNullOrEmpty(name)) return "#bebebe";
    var n = name.ToLower().Trim();

    // Đen / Xám / Titanium
    if (n.Contains("đen vân cacbon")) return "#1c1c1c";
    if (n.Contains("đen không gian") || n.Contains("space black")) return "#232426";
    if (n.Contains("đen titan") || n.Contains("titan đen") || n.Contains("titanium đen")) return "#282829";
    if (n.Contains("đen bóng")) return "#0c0d0e";
    if (n.Contains("đen xanh") || n.Contains("xanh đen") || n.Contains("đen huyền bí")) return "#1f262e";
    if (n.Contains("đen") || n.Contains("black")) return "#222222";
    if (n.Contains("titan tự nhiên") || n.Contains("tự nhiên titan") || n.Contains("natural titanium")) return "#a6a6a4";
    if (n.Contains("titan xám") || n.Contains("xám bạc") || n.Contains("xám đá") || n.Contains("xám") || n.Contains("gray") || n.Contains("grey")) return "#8e8e93";

    // Trắng / Bạc
    if (n.Contains("bạc shadow") || n.Contains("silver shadow")) return "#d1d5db";
    if (n.Contains("bạc ánh trăng") || n.Contains("moonlight silver")) return "#e5e7eb";
    if (n.Contains("trắng titan") || n.Contains("titan trắng")) return "#e3e4e5";
    if (n.Contains("trắng bạc") || n.Contains("titan trắng bạc")) return "#eceeed";
    if (n.Contains("bạc bóng") || n.Contains("bạc") || n.Contains("silver")) return "#e3e4e6";
    if (n.Contains("trắng hồng") || n.Contains("hồng đào") || n.Contains("trắng") || n.Contains("white")) return "#f9f9fb";

    // Vàng / Sa mạc / Đồng / Gold
    if (n.Contains("sa mạc titan") || n.Contains("desert titanium") || n.Contains("sa mạc")) return "#c2b29c";
    if (n.Contains("titan vàng hồng") || n.Contains("vàng hồng") || n.Contains("pink gold")) return "#e8c3b9";
    if (n.Contains("vàng nhạt")) return "#f7ebd3";
    if (n.Contains("vàng vangarde") || n.Contains("vàng") || n.Contains("gold") || n.Contains("yellow")) return "#f9e09b";

    // Hồng / Đỏ
    if (n.Contains("hồng phấn") || n.Contains("soft pink")) return "#f7d5d7";
    if (n.Contains("hồng") || n.Contains("pink")) return "#ffc5cb";
    if (n.Contains("đỏ san hô") || n.Contains("đỏ") || n.Contains("red")) return "#d03a3a";

    // Xanh Lá / Mint / Ngọc / Xô Thơm
    if (n.Contains("titan xanh ngọc") || n.Contains("xanh ngọc") || n.Contains("jade green")) return "#9cd3c2";
    if (n.Contains("xanh bạc hà") || n.Contains("xanh mint") || n.Contains("mint")) return "#bce3cb";
    if (n.Contains("xanh xô thơm") || n.Contains("sage")) return "#b4c3b6";
    if (n.Contains("teal") || n.Contains("mòng két")) return "#4f7f80";
    if (n.Contains("xanh lá") || n.Contains("green")) return "#a2cd5a";

    // Xanh Dương / Navy / Băng / Sương Mù
    if (n.Contains("xanh sâu thẳm") || n.Contains("deep blue") || n.Contains("dark blue")) return "#2d4257";
    if (n.Contains("xanh navy") || n.Contains("navy")) return "#1b365d";
    if (n.Contains("xanh titan") || n.Contains("titan xanh") || n.Contains("xanh dương titan")) return "#4f637a";
    if (n.Contains("xanh bầu trời") || n.Contains("sky blue")) return "#a5c4d4";
    if (n.Contains("xanh sương mù") || n.Contains("mist blue")) return "#99aab8";
    if (n.Contains("xanh băng giá") || n.Contains("xanh băng") || n.Contains("icy blue")) return "#d2e3eb";
    if (n.Contains("xanh craft") || n.Contains("xanh dương") || n.Contains("xanh") || n.Contains("blue") || n.Contains("xanh lưu ly")) return "#5b7795";

    // Tím / Oải Hương / Cam
    if (n.Contains("oải hương") || n.Contains("lavender")) return "#dfdaf2";
    if (n.Contains("cam vũ trụ") || n.Contains("cosmic orange")) return "#e36e3b";

    return "#808080";
  }
}

@section Scripts {
<script>
  // Dynamic Data Serialization
  const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(images.Select(i => new { i.ImageUrl, i.IsMain })));
  const variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(variants.Select(v => new { v.Id, v.Color, v.StorageGb, v.Price, v.Stock })));

  let selectedColor = null;
  let selectedStorage = null;
  let selectedVariantId = null;

  // Find image matching color name pattern
  function getImageForColor(colorName) {
    if (!images || images.length === 0) return null;
    const normalized = colorName.toLowerCase().replace(/\s+/g, '').trim();
    
    // Translation/mapping table for specific color names
    const colorMap = {
      'đenkhônggian': ['spaceblack', 'black'],
      'bạcánhtrăng': ['cloudwhite', 'white', 'silver'],
      'xanhbầutrời': ['skyblue', 'blue'],
      'vàngnhạt': ['lightgold', 'gold', 'yellow'],
      'camvũtrụ': ['cosmicorange', 'orange'],
      'xanhsâuthẳm': ['deepblue', 'blue'],
      'bạc': ['silver', 'white'],
      'xanhsươngmù': ['mist_blue', 'mist', 'blue'],
      'oảihương': ['lavender', 'purple'],
      'xanhxôthơm': ['sage', 'green'],
      'hồngphấn': ['soft-pink', 'pink'],
      'đỏsanthô': ['coralred', 'red'],
      'santhôđỏ': ['coralred', 'red'],
      'xanhbănggiá': ['icyblue', 'blue'],
      'đenxanh': ['blueblack', 'black'],
      'xanhđen': ['blueblack', 'black'],
      'xanhbạchà': ['mint', 'green'],
      'xanhnavy': ['navy', 'blue'],
      'vànghồng': ['pinkgold', 'pink'],
      'titanxám': ['titaniumgray', 'gray', 'grey'],
      'xámtitan': ['titaniumgray', 'gray', 'grey'],
      'titanđen': ['titaniumblack', 'black'],
      'đentitan': ['titaniumblack', 'black'],
      'titanđenbóng': ['titaniumjetblack', 'black'],
      'đenbóngtitan': ['titaniumjetblack', 'black'],
      'titantrắngbạc': ['titaniumwhitesilver', 'silver', 'white'],
      'trắngbạctitan': ['titaniumwhitesilver', 'silver', 'white'],
      'trắngtitan': ['titaniumwhitesilver', 'silver', 'white'],
      'titanxanhngọc': ['titaniumjadegreen', 'green'],
      'xanhngọctitan': ['titaniumjadegreen', 'green'],
      'titanxanhbạc': ['titaniumsilverblue', 'blue'],
      'xanhbạctitan': ['titaniumsilverblue', 'blue'],
      'titanvànghồng': ['titaniumpinkgold', 'pink'],
      'vànghồngtitan': ['titaniumpinkgold', 'pink'],
      'đenvâncacbon': ['crafted-black', 'carbon', 'black'],
      'vâncacbonđen': ['crafted-black', 'carbon', 'black'],
      'hồngđào': ['peach', 'pink'],
      'đàohồng': ['peach', 'pink'],
      'bạcshadow': ['silver-shadow', 'silvershadow', 'silver'],
      'xanhdương': ['blue'],
      'xanhdươngtitan': ['bluetitanium', 'blue'],
      'titantựnhiên': ['naturaltitanium', 'natural', 'gray', 'grey'],
      'samactitan': ['deserttitanium', 'desert', 'gold'],
      'sa mạctitan': ['deserttitanium', 'desert', 'gold'],
      'xanhlưuly': ['ultramarine', 'blue'],
      'trắngbạc': ['whitesilver', 'white', 'silver'],
    };

    // First try exact matches with mapped keywords
    const keywords = colorMap[normalized] || [];
    for (const kw of keywords) {
      const match = images.find(img => {
        const url = img.ImageUrl.toLowerCase();
        const filename = url.substring(url.lastIndexOf('/') + 1);
        return filename.includes(kw);
      });
      if (match) return match.ImageUrl;
    }

    // Try finding by normalized name directly in filename
    const matchDirect = images.find(img => {
      const url = img.ImageUrl.toLowerCase();
      const filename = url.substring(url.lastIndexOf('/') + 1);
      
      const removeDiacritics = (str) => str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
      const filenameClean = removeDiacritics(filename);
      const normalizedClean = removeDiacritics(normalized);
      
      return filenameClean.includes(normalizedClean);
    });
    if (matchDirect) return matchDirect.ImageUrl;

    // Fallback: general mapping based on generic terms
    let matchGeneric = images.find(img => {
      const url = img.ImageUrl.toLowerCase();
      if ((normalized.includes("đen") || normalized.includes("black")) && (url.includes("black") || url.includes("dark") || url.includes("carbon") || url.includes("shadow"))) return true;
      if ((normalized.includes("trắng") || normalized.includes("white")) && (url.includes("white") || url.includes("light"))) return true;
      if ((normalized.includes("bạc") || normalized.includes("silver")) && (url.includes("silver") || url.includes("shadow") || url.includes("whitesilver"))) return true;
      if ((normalized.includes("tựnhiên") || normalized.includes("natural")) && (url.includes("natural") || url.includes("gray") || url.includes("grey") || url.includes("slate"))) return true;
      if ((normalized.includes("vàng") || normalized.includes("yellow") || normalized.includes("gold")) && (url.includes("gold") || url.includes("yellow") || url.includes("vangarde"))) return true;
      if ((normalized.includes("xanh") || normalized.includes("blue") || normalized.includes("navy") || normalized.includes("mòngkét")) && (url.includes("blue") || url.includes("navy") || url.includes("sky") || url.includes("icy") || url.includes("craft") || url.includes("teal") || url.includes("ultramarine"))) return true;
      if ((normalized.includes("lá") || normalized.includes("green") || normalized.includes("mint") || normalized.includes("sage")) && (url.includes("green") || url.includes("sage") || url.includes("mint") || url.includes("teal") || url.includes("jade"))) return true;
      if ((normalized.includes("hồng") || normalized.includes("pink") || normalized.includes("đào") || normalized.includes("peach")) && (url.includes("pink") || url.includes("peach") || url.includes("rose") || url.includes("soft-pink") || url.includes("soft_pink"))) return true;
      if ((normalized.includes("oảihương") || normalized.includes("lavender")) && (url.includes("lavender") || url.includes("purple"))) return true;
      if ((normalized.includes("sươngmù") || normalized.includes("mist")) && url.includes("mist")) return true;
      if ((normalized.includes("cam") || normalized.includes("orange")) && url.includes("orange")) return true;
      if ((normalized.includes("đỏ") || normalized.includes("red")) && (url.includes("red") || url.includes("coral"))) return true;
      return false;
    });

    if (matchGeneric) return matchGeneric.ImageUrl;

    // Last resort: find the main image or first image
    const mainImg = images.find(img => img.IsMain);
    return mainImg ? mainImg.ImageUrl : (images[0] ? images[0].ImageUrl : null);
  }

  // Handle color selection
  function selectColor(btn, color) {
    document.querySelectorAll('#colorStep .buy-flow-color-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    selectedColor = color;
    document.getElementById('selectedColorLabel').textContent = color;

    // Transition image with soft fade and preload to prevent blinking
    const newSrc = getImageForColor(color);
    if (newSrc) {
      const mainImgEl = document.getElementById('mainImage');
      const tempImgEl = document.getElementById('mainImageTemp');
      if (tempImgEl) {
        tempImgEl.onload = () => {
          tempImgEl.style.opacity = '1';
          setTimeout(() => {
            mainImgEl.src = newSrc;
            tempImgEl.style.opacity = '0';
          }, 300);
        };
        tempImgEl.src = newSrc;
      } else {
        mainImgEl.src = newSrc;
      }
    }

    // Activate Step 2
    const storageStep = document.getElementById('storageStep');
    if (storageStep) storageStep.classList.add('active');

    // Populate storage grid based on color
    const grid = document.getElementById('storageGrid');
    if (grid) {
      grid.innerHTML = '';

      const colorVariants = variants.filter(v => v.Color === color);
      
      // Sort storages ascending
      colorVariants.sort((a, b) => a.StorageGb - b.StorageGb);

      colorVariants.forEach(v => {
        const card = document.createElement('div');
        card.className = 'buy-flow-storage-card';
        if (selectedStorage === v.StorageGb) {
          card.classList.add('active');
          selectedVariantId = v.Id;
        }
        card.innerHTML = `
          <span class="buy-flow-storage-cap">${v.StorageGb} GB</span>
          <span class="buy-flow-storage-price">${v.Price.toLocaleString('vi-VN')}₫</span>
        `;
        card.onclick = () => selectStorage(card, v.StorageGb, v.Price, v.Id);
        grid.appendChild(card);
      });
    }

    updateSummary();
  }

  // Handle storage selection
  function selectStorage(cardEl, storage, price, variantId) {
    document.querySelectorAll('.buy-flow-storage-card').forEach(c => c.classList.remove('active'));
    cardEl.classList.add('active');

    selectedStorage = storage;
    selectedVariantId = variantId;

    updateSummary();
  }

  // Update selection text and enable checkout button
  function updateSummary() {
    const displayPrice = document.getElementById('displayPrice');
    const summaryText = document.getElementById('summarySelectionText');
    const submitBtn = document.getElementById('btnBuyFlowAdd');

    if (selectedColor && selectedStorage) {
      // Find variant details
      const variant = variants.find(v => v.Id === selectedVariantId);
      const priceVal = variant ? variant.Price : 0;
      
      if (displayPrice) displayPrice.textContent = priceVal.toLocaleString('vi-VN') + '₫';
      if (summaryText) summaryText.textContent = `@Model.Product.Name, Màu: ${selectedColor}, Dung lượng: ${selectedStorage}GB`;
      
      // Unlock checkout button
      if (submitBtn) {
        submitBtn.classList.remove('locked');
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Thêm vào giỏ hàng';
      }
    } else {
      let missing = [];
      if (!selectedColor) missing.push("màu sắc");
      if (!selectedStorage) missing.push("dung lượng");
      
      if (summaryText) summaryText.textContent = "Vui lòng chọn " + missing.join(" và ");
      if (submitBtn) {
        submitBtn.classList.add('locked');
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Hoàn thành các bước chọn';
      }
    }
  }

  // Add item to cart
  function addToCartDetail(event) {
    if (!selectedVariantId) {
      showToast("Vui lòng hoàn thành đầy đủ lựa chọn", "error");
      return;
    }
    addToCart(@p.Id, event, parseInt(selectedVariantId), 1);
  }

  // Auto-select first variant on load if exists
  document.addEventListener('DOMContentLoaded', () => {
    const firstColorBtn = document.querySelector('#colorStep .buy-flow-color-pill');
    if (firstColorBtn) {
      firstColorBtn.click();
    }
  });

  // Product Comparison logic
  let allCompareProducts = [];
  let selectedCompareIds = [];
  let isCompareListLoaded = false;

  function openCompareModal() {
    const modalEl = document.getElementById('compareSelectModal');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    if (!isCompareListLoaded) {
      fetch(`/Product/GetCompareList?currentProductId=@p.Id`)
        .then(res => res.json())
        .then(data => {
          allCompareProducts = data;
          isCompareListLoaded = true;
          renderCompareProducts(data);
        })
        .catch(err => {
          console.error("Lỗi khi tải danh sách sản phẩm so sánh:", err);
          document.getElementById('compareProductList').innerHTML = '<p class="text-center text-danger py-4">Không thể tải danh sách sản phẩm. Vui lòng thử lại sau.</p>';
        });
    }
  }

  function renderCompareProducts(products) {
    const listEl = document.getElementById('compareProductList');
    if (!products || products.length === 0) {
      listEl.innerHTML = '<p class="text-center text-muted py-4">Không tìm thấy sản phẩm nào.</p>';
      return;
    }

    listEl.innerHTML = products.map(prod => {
      const isChecked = selectedCompareIds.includes(prod.id) ? 'checked' : '';
      return `
        <div class="compare-prod-item d-flex align-items-center justify-content-between p-2 mb-2 rounded-3" style="border: 1px solid rgba(194, 178, 128, 0.15); background: #fff; transition: all 0.2s ease;" id="compare-item-${prod.id}">
          <div class="d-flex align-items-center gap-3">
            <img src="${prod.image}" alt="${prod.name}" style="width: 48px; height: 48px; object-fit: contain; border-radius: 6px;" />
            <div>
              <h6 class="mb-0 fw-semibold fs-6 text-navy">${prod.name}</h6>
              <span class="badge bg-secondary text-white font-monospace" style="font-size: 10px;">${prod.brand}</span>
            </div>
          </div>
          <div class="form-check pe-3">
            <input class="form-check-input compare-chk" type="checkbox" value="${prod.id}" id="chk-${prod.id}" ${isChecked} onchange="onCompareCheckboxChange(this, ${prod.id})">
          </div>
        </div>
      `;
    }).join('');
  }

  function filterCompareList() {
    const q = document.getElementById('compareSearchInput').value.toLowerCase().trim();
    if (!q) {
      renderCompareProducts(allCompareProducts);
      return;
    }
    const filtered = allCompareProducts.filter(p => p.name.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q));
    renderCompareProducts(filtered);
  }

  function onCompareCheckboxChange(chk, id) {
    if (chk.checked) {
      if (selectedCompareIds.length >= 2) {
        chk.checked = false;
        alert("Chỉ được chọn tối đa 2 sản phẩm khác để so sánh!");
        return;
      }
      selectedCompareIds.push(id);
    } else {
      selectedCompareIds = selectedCompareIds.filter(x => x !== id);
    }
    
    // Update border styling
    document.querySelectorAll('.compare-prod-item').forEach(item => {
      item.style.borderColor = 'rgba(194, 178, 128, 0.15)';
      item.style.background = '#fff';
    });
    selectedCompareIds.forEach(selectedId => {
      const itemEl = document.getElementById(`compare-item-${selectedId}`);
      if (itemEl) {
        itemEl.style.borderColor = 'var(--camel)';
        itemEl.style.background = 'rgba(194, 178, 128, 0.05)';
      }
    });

    // Update count
    document.getElementById('selectedCompareCountNum').textContent = selectedCompareIds.length;
    
    // Update button state
    const btn = document.getElementById('btnGoToCompare');
    if (selectedCompareIds.length > 0) {
      btn.removeAttribute('disabled');
      btn.style.opacity = '1';
    } else {
      btn.setAttribute('disabled', 'true');
      btn.style.opacity = '0.5';
    }
  }

  function goToComparisonPage(currentId) {
    if (selectedCompareIds.length === 0) return;
    const ids = [currentId, ...selectedCompareIds].join(',');
    window.location.href = `/Product/Compare?ids=${ids}`;
  }
</script>
}
