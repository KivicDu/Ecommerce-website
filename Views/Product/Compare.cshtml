@* Functions for background color code mapping *@
@functions {
  public static string GetHexForColorName(string name)
  {
    var n = name.ToLower().Trim();
    if (n.Contains("space black") || n.Contains("đen không gian") || n.Contains("black") || n.Contains("đen")) return "#232426";
    if (n.Contains("natural titanium") || n.Contains("titan tự nhiên") || n.Contains("gray") || n.Contains("xám")) return "#a6a6a4";
    if (n.Contains("white titanium") || n.Contains("trắng titan") || n.Contains("white") || n.Contains("trắng")) return "#f2f2f2";
    if (n.Contains("desert titanium") || n.Contains("sa mạc") || n.Contains("gold") || n.Contains("vàng")) return "#c2b29c";
    if (n.Contains("silver") || n.Contains("bạc")) return "#e3e4e6";
    if (n.Contains("blue") || n.Contains("xanh")) return "#5b7795";
    return "#e8e8e8"; // Fallback grey
  }
}

@section Scripts {
<script>
  function toggleDifferencesOnly() {
    const showDiffOnly = document.getElementById('toggleDiffs').checked;
    const rows = document.querySelectorAll('tr.compare-row');
    
    rows.forEach(row => {
      const cells = Array.from(row.querySelectorAll('td.compare-val'));
      if (cells.length > 1) {
        const firstVal = cells[0].textContent.trim();
        const allSame = cells.every(cell => cell.textContent.trim() === firstVal);
        if (allSame) {
          if (showDiffOnly) {
            row.style.display = 'none';
          } else {
            row.style.display = '';
          }
        }
      }
    });
  }

  function removeProductFromComparison(prodId) {
    // Parse the current product ids from the URL query parameter `ids`
    const urlParams = new URLSearchParams(window.location.search);
    let idsStr = urlParams.get('ids');
    if (!idsStr) return;

    let idArray = idsStr.split(',').map(x => x.trim()).filter(x => x.length > 0);
    // Filter out the deleted product id
    idArray = idArray.filter(id => id !== prodId.toString());

    if (idArray.length === 0) {
      window.location.href = '/Product';
    } else {
      window.location.href = '/Product/Compare?ids=' + idArray.join(',');
    }
  }
</script>
}
