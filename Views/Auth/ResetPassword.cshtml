@model HutechStore.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }

<div class="auth-page">
  <div class="container"><div class="row justify-content-center"><div class="col-md-4">
    <div class="auth-card">
      <div class="auth-logo">
        <i class="fas fa-key text-danger fa-2x"></i>
        <h5 class="mt-2 fw-bold">Đặt mật khẩu mới</h5>
      </div>
      <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email"/>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
          <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="NewPassword" class="form-control" type="password"
                   placeholder="Tối thiểu 6 ký tự" id="np"/>
            <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('np',this)">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
          <label asp-for="ConfirmPassword" class="form-label fw-semibold">Nhập lại mật khẩu</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="ConfirmPassword" class="form-control" type="password"
                   placeholder="Nhập lại" id="cp2"/>
            <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('cp2',this)">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-danger w-100 fw-bold py-2">
          <i class="fas fa-save me-2"></i>Đặt lại mật khẩu
        </button>
      </form>
    </div>
  </div></div></div>
</div>

@section Scripts {
<script>
  function togglePwd(id, btn) {
    const el = document.getElementById(id);
    const ic = btn.querySelector('i');
    el.type = el.type === 'password' ? 'text' : 'password';
    ic.classList.toggle('fa-eye'); ic.classList.toggle('fa-eye-slash');
  }
</script>
}
