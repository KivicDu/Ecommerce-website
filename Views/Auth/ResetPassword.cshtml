@model HutechStore.ViewModels.ResetPasswordViewModel
@{
  ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="auth-card-luxury">

          @* Header *@
          <div class="auth-logo-luxury text-center">
            <h2 class="auth-title-cinzel">HUTECHSTORE</h2>
            <p class="auth-subtitle-luxury">Thiết lập mật khẩu mới</p>
            <p class="text-muted small mt-2">Vui lòng nhập mật khẩu mới bảo mật cao</p>
          </div>

          <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email"/>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
              <label asp-for="NewPassword" class="form-label-clean">Mật khẩu mới</label>
              <div class="input-group-clean">
                <input asp-for="NewPassword" class="form-control form-control-clean" type="password" placeholder="Tối thiểu 6 ký tự" id="np"/>
                <button class="btn btn-show-pwd" type="button" onclick="togglePwd('np',this)"><i class="far fa-eye"></i></button>
              </div>
              <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
              <label asp-for="ConfirmPassword" class="form-label-clean">Nhập lại mật khẩu</label>
              <div class="input-group-clean">
                <input asp-for="ConfirmPassword" class="form-control form-control-clean" type="password" placeholder="Nhập lại mật khẩu" id="cp2"/>
                <button class="btn btn-show-pwd" type="button" onclick="togglePwd('cp2',this)"><i class="far fa-eye"></i></button>
              </div>
              <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-luxury-submit w-100">
              Đặt lại mật khẩu
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
