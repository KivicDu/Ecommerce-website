@model HutechStore.ViewModels.RegisterViewModel
@{
  ViewData["Title"] = "Đăng ký";
}

<div class="auth-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="auth-card-luxury">

          @* Header *@
          <div class="auth-logo-luxury text-center">
            <h2 class="auth-title-cinzel">HUTECHSTORE</h2>
            <p class="auth-subtitle-luxury">Đăng ký tài khoản</p>
          </div>

          @* Google Register *@
          <a href="/Auth/LoginWithGoogle" class="btn btn-google-clean w-100 mb-3">
            <svg width="18" height="18" viewBox="0 0 48 48" class="me-2">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.36-8.16 2.36-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Đăng ký qua Google
          </a>

          <div class="auth-divider-clean"><span>hoặc điền thông tin</span></div>

          <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3 mb-2">
              <div class="col-12">
                <label asp-for="Name" class="form-label-clean">Họ và tên</label>
                <input asp-for="Name" class="form-control form-control-clean" placeholder="Nguyễn Văn A"/>
                <span asp-validation-for="Name" class="text-danger small"></span>
              </div>
              <div class="col-12">
                <label asp-for="Email" class="form-label-clean">Địa chỉ Email</label>
                <input asp-for="Email" class="form-control form-control-clean" placeholder="name@email.com"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
              </div>
              <div class="col-md-6">
                <label asp-for="Password" class="form-label-clean">Mật khẩu</label>
                <div class="input-group-clean">
                  <input asp-for="Password" class="form-control form-control-clean" type="password" placeholder="Tối thiểu 6 ký tự" id="pwd1"/>
                  <button class="btn btn-show-pwd" type="button" onclick="togglePwd('pwd1',this)"><i class="far fa-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
              </div>
              <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label-clean">Nhập lại mật khẩu</label>
                <div class="input-group-clean">
                  <input asp-for="ConfirmPassword" class="form-control form-control-clean" type="password" placeholder="Nhập lại" id="pwd2"/>
                  <button class="btn btn-show-pwd" type="button" onclick="togglePwd('pwd2',this)"><i class="far fa-eye"></i></button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
              </div>
              <div class="col-md-6">
                <label asp-for="Phone" class="form-label-clean">Số điện thoại <span class="text-muted text-lowercase">(tùy chọn)</span></label>
                <input asp-for="Phone" class="form-control form-control-clean" placeholder="Số điện thoại"/>
              </div>
              <div class="col-md-6">
                <label asp-for="Address" class="form-label-clean">Địa chỉ giao hàng <span class="text-muted text-lowercase">(tùy chọn)</span></label>
                <input asp-for="Address" class="form-control form-control-clean" placeholder="Địa chỉ giao hàng"/>
              </div>
            </div>

            <button type="submit" class="btn btn-luxury-submit w-100 mt-4">
              Đăng ký tài khoản
            </button>
          </form>

          <p class="text-center mt-4 mb-0 small text-muted">
            Đã có tài khoản?
            <a asp-controller="Auth" asp-action="Login" class="auth-switch-link">
              Đăng nhập
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
