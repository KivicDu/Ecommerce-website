@model HutechStore.ViewModels.LoginViewModel
@{
  ViewData["Title"] = "Đăng nhập";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="auth-card-luxury">

          @* Header *@
          <div class="auth-logo-luxury text-center">
            <h2 class="auth-title-cinzel">HUTECHSTORE</h2>
            <p class="auth-subtitle-luxury">Đăng nhập tài khoản</p>
          </div>

          @* Google Login *@
          <a href="/Auth/LoginWithGoogle" class="btn btn-google-clean w-100 mb-3">
            <svg width="18" height="18" viewBox="0 0 48 48" class="me-2">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.36-8.16 2.36-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Đăng nhập qua Google
          </a>

          <div class="auth-divider-clean"><span>hoặc sử dụng email</span></div>

          @* Form *@
          <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
              <label asp-for="Email" class="form-label-clean">Địa chỉ Email</label>
              <input asp-for="Email" class="form-control form-control-clean" placeholder="name@email.com" autocomplete="email"/>
              <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="Password" class="form-label-clean mb-0">Mật khẩu</label>
                <a asp-controller="Auth" asp-action="ForgotPassword" class="forgot-link">Quên mật khẩu?</a>
              </div>
              <div class="input-group-clean">
                <input asp-for="Password" class="form-control form-control-clean" type="password" placeholder="Mật khẩu" autocomplete="current-password" id="pwdInput"/>
                <button class="btn btn-show-pwd" type="button" onclick="togglePwd('pwdInput',this)">
                  <i class="far fa-eye"></i>
                </button>
              </div>
              <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-luxury-submit w-100">
              Đăng nhập
            </button>
          </form>

          <p class="text-center mt-4 mb-0 small text-muted">
            Chưa có tài khoản?
            <a asp-controller="Auth" asp-action="Register" class="auth-switch-link">
              Đăng ký ngay
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
