@model HutechStore.ViewModels.VerifyOtpViewModel
@{ ViewData["Title"] = "Xác nhận OTP"; }

<div class="auth-page">
  <div class="container"><div class="row justify-content-center"><div class="col-md-4">
    <div class="auth-card">
      <div class="auth-logo">
        <i class="fas fa-shield-alt text-danger fa-2x"></i>
        <h5 class="mt-2 fw-bold">Nhập mã OTP</h5>
        <p class="text-muted small">Mã OTP đã được gửi tới <strong>@Model.Email</strong></p>
      </div>
      <form asp-action="VerifyOtp" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email"/>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
          <label asp-for="Otp" class="form-label fw-semibold">Mã OTP (6 chữ số)</label>
          <input asp-for="Otp" class="form-control form-control-lg text-center fw-bold"
                 maxlength="6" placeholder="······" style="letter-spacing:8px;font-size:1.5rem"
                 autocomplete="one-time-code"/>
          <span asp-validation-for="Otp" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-danger w-100 fw-bold py-2">
          <i class="fas fa-check me-2"></i>Xác nhận
        </button>
      </form>
      <p class="text-center mt-3 mb-0 small text-muted">Mã có hiệu lực 10 phút</p>
    </div>
  </div></div></div>
</div>
