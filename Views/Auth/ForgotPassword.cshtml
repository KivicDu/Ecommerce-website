@model HutechStore.ViewModels.ForgotPasswordViewModel
@{
  ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="auth-card-luxury">

          @* Header *@
          <div class="auth-logo-luxury text-center">
            <h2 class="auth-title-cinzel">HUTECHSTORE</h2>
            <p class="auth-subtitle-luxury">Khôi phục mật khẩu</p>
            <p class="text-muted small mt-2">Vui lòng nhập địa chỉ Email đăng ký tài khoản</p>
          </div>

          <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            
            <div class="mb-4">
              <label asp-for="Email" class="form-label-clean">Địa chỉ Email</label>
              <input asp-for="Email" class="form-control form-control-clean" placeholder="name@email.com"/>
              <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-luxury-submit w-100">
              Gửi mã OTP
            </button>
          </form>

          <p class="text-center mt-4 mb-0 small">
            <a asp-action="Login" class="auth-switch-link">← Quay lại đăng nhập</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
