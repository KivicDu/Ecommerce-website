@* ── ForgotPassword.cshtml ───────────────────────────────────── *@
@* Lưu thành: Views/Auth/ForgotPassword.cshtml *@
@model HutechStore.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }

<div class="auth-page">
  <div class="container"><div class="row justify-content-center"><div class="col-md-4">
    <div class="auth-card">
      <div class="auth-logo">
        <i class="fas fa-lock text-danger fa-2x"></i>
        <h5 class="mt-2 fw-bold">Quên mật khẩu</h5>
        <p class="text-muted small">Nhập email để nhận mã OTP đặt lại mật khẩu</p>
      </div>
      <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
          <label asp-for="Email" class="form-label fw-semibold">Email</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control" placeholder="your@email.com"/>
          </div>
          <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-danger w-100 fw-bold py-2">
          <i class="fas fa-paper-plane me-2"></i>Gửi mã OTP
        </button>
      </form>
      <p class="text-center mt-3 mb-0 small">
        <a asp-action="Login" class="text-danger">← Quay lại đăng nhập</a>
      </p>
    </div>
  </div></div></div>
</div>
