@* ════════════════════════════════════════════════════════════════
   _Footer.cshtml — Footer toàn trang
   ════════════════════════════════════════════════════════════════ *@

<footer class="site-footer">

  @* ── FOOTER MAIN ── *@
  <div class="footer-main">
    <div class="container">
      <div class="row g-4">

        @* COL 1: Thương hiệu *@
        <div class="col-lg-4 col-md-6">
          <div class="footer-brand">
            <h4 class="footer-logo luxury-logo" style="font-size:1.4rem; margin-bottom:1rem;">
              HUTECHSTORE
            </h4>
            <p class="footer-tagline">
              Cửa hàng điện thoại uy tín hàng đầu — chuyên iPhone &amp; Samsung chính hãng.
              Tư vấn chuyên nghiệp, chất lượng dịch vụ đẳng cấp vượt trội.
            </p>
            <div class="social-links mt-3">
              <a href="#" class="social-link-text me-3" aria-label="Facebook">FACEBOOK</a>
              <a href="#" class="social-link-text me-3" aria-label="Zalo">ZALO</a>
              <a href="#" class="social-link-text me-3" aria-label="YouTube">YOUTUBE</a>
              <a href="#" class="social-link-text" aria-label="TikTok">TIKTOK</a>
            </div>
          </div>
        </div>

        @* COL 2: Liên kết nhanh *@
        <div class="col-lg-2 col-md-6">
          <h6 class="footer-heading">Liên kết</h6>
          <ul class="footer-links">
            <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li><a asp-controller="Product" asp-action="Index" asp-route-brand="Apple">iPhone</a></li>
            <li><a asp-controller="Product" asp-action="Index" asp-route-brand="Samsung">Samsung</a></li>
            <li><a asp-controller="Home" asp-action="About">Về chúng tôi</a></li>
            <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
          </ul>
        </div>

        @* COL 3: Hỗ trợ *@
        <div class="col-lg-2 col-md-6">
          <h6 class="footer-heading">Hỗ trợ</h6>
          <ul class="footer-links">
            <li><a href="#">Chính sách bảo hành</a></li>
            <li><a href="#">Chính sách đổi trả</a></li>
            <li><a href="#">Hướng dẫn mua hàng</a></li>
            <li><a href="#">Tra cứu đơn hàng</a></li>
            <li><a asp-controller="Auth" asp-action="Login">Tài khoản của tôi</a></li>
          </ul>
        </div>

        @* COL 4: Liên hệ + Địa chỉ *@
        <div class="col-lg-4 col-md-6">
          <h6 class="footer-heading">Liên hệ</h6>
          <ul class="footer-contact">
            <li>
              <span>475A Điện Biên Phủ, P.25, Q.Bình Thạnh, TP.HCM</span>
            </li>
            <li>
              <span>Hotline: <a href="tel:19001234">1900 1234</a> (7:30 - 22:00)</span>
            </li>
            <li>
              <span>Email: <a href="mailto:info@hutechstore.com">info@hutechstore.com</a></span>
            </li>
          </ul>

          @* Payment badges *@
          <div class="payment-badges mt-3">
            <span class="payment-badge-clean me-2">COD</span>
            <span class="payment-badge-clean me-2">VNPAY</span>
            <span class="payment-badge-clean">MOMO</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  @* ── FOOTER BOTTOM ── *@
  <div class="footer-bottom">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
      <span>&copy; @DateTime.Now.Year HUTECHSTORE. All rights reserved.</span>
      <span class="text-muted small">Designed for elegance by Hutech Team</span>
    </div>
  </div>

</footer>
