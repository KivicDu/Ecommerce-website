@* ════════════════════════════════════════════════════════════════
   _ChatWidget.cshtml — AI Chatbot tư vấn điện thoại
   Widget nổi góc dưới bên phải màn hình
   Để thay đổi màu: sửa biến --chat-* trong site.css
   ════════════════════════════════════════════════════════════════ *@

<div id="chatWidget" class="chat-widget" role="complementary" aria-label="Tư vấn AI">

  @* ── NÚT MỞ CHAT ── *@
  <button id="chatToggle" class="chat-toggle-btn" onclick="toggleChat()"
          aria-label="Mở chat tư vấn" title="Tư vấn AI">
    <div class="chat-icon-wrap">
      <i class="fas fa-robot chat-icon-open"></i>
      <i class="fas fa-times chat-icon-close d-none"></i>
    </div>
    <span class="chat-badge-dot" id="chatDot"></span>
  </button>

  @* ── CỬA SỔ CHAT ── *@
  <div id="chatWindow" class="chat-window d-none" aria-live="polite">

    @* Header *@
    <div class="chat-header">
      <div class="chat-header-info">
        <div class="chat-avatar">
          <i class="fas fa-robot"></i>
        </div>
        <div>
          <div class="chat-name">AI Tư vấn</div>
          <div class="chat-status">
            <span class="status-dot"></span> Luôn sẵn sàng
          </div>
        </div>
      </div>
      <div class="chat-header-actions">
        <button class="chat-action-btn" onclick="clearChat()" title="Xóa lịch sử">
          <i class="fas fa-trash-alt"></i>
        </button>
        <button class="chat-action-btn" onclick="toggleChat()" title="Đóng">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>

    @* Messages *@
    <div id="chatMessages" class="chat-messages">
      <div class="chat-msg assistant">
        <div class="msg-avatar"><i class="fas fa-robot"></i></div>
        <div class="msg-bubble">
          <p>Xin chào! 👋 Mình là AI tư vấn của <strong>HutechStore</strong>.</p>
          <p>Mình có thể giúp bạn:</p>
          <ul class="mb-0">
            <li>🎮 Tìm điện thoại <strong>chơi game</strong> tốt nhất</li>
            <li>📸 Gợi ý điện thoại <strong>chụp ảnh</strong> đẹp</li>
            <li>💰 Tư vấn theo <strong>ngân sách</strong> của bạn</li>
            <li>⚖️ So sánh <strong>iPhone vs Samsung</strong></li>
          </ul>
        </div>
      </div>

      @* Quick replies gợi ý *@
      <div class="quick-replies" id="quickReplies">
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">🎮 Chơi game dưới 15tr</button>
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">📸 Chụp ảnh đẹp nhất</button>
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">💰 Tầm 20-25 triệu</button>
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">⚖️ iPhone vs Samsung</button>
      </div>
    </div>

    @* Input *@
    <div class="chat-input-area">
      <div class="chat-input-wrap">
        <input type="text" id="chatInput" class="chat-input"
               placeholder="Nhập câu hỏi..."
               maxlength="500"
               onkeydown="if(event.key==='Enter')sendMessage()"/>
        <button class="chat-send-btn" onclick="sendMessage()" id="chatSendBtn">
          <i class="fas fa-paper-plane"></i>
        </button>
      </div>
      <div class="chat-footer-note">
        <i class="fas fa-magic me-1"></i>Powered by Gemini AI · Dữ liệu thực từ HutechStore
      </div>
    </div>

  </div>
</div>
