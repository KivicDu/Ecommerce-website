@* ════════════════════════════════════════════════════════════════
   _ChatWidget.cshtml — AI Chatbot tư vấn điện thoại
   ════════════════════════════════════════════════════════════════ *@

<div id="chatWidget" class="chat-widget" role="complementary" aria-label="Tư vấn AI">

  @* ── NÚT MỞ CHAT ── *@
  <button id="chatToggle" class="chat-toggle-btn" onclick="toggleChat()"
          aria-label="Mở chat tư vấn" title="Tư vấn AI">
    <div class="chat-icon-wrap">
      @* Sử dụng icon trò chuyện tinh gọn *@
      <i class="far fa-comment-alt chat-icon-open" style="font-size: 1.3rem;"></i>
      <i class="fas fa-times chat-icon-close d-none" style="font-size: 1.3rem;"></i>
    </div>
    <span class="chat-badge-dot" id="chatDot"></span>
  </button>

  @* ── CỬA SỔ CHAT ── *@
  <div id="chatWindow" class="chat-window d-none" aria-live="polite">

    @* Header *@
    <div class="chat-header">
      <div class="chat-header-info">
        <div class="chat-avatar-text">AI</div>
        <div>
          <div class="chat-name">Trợ lý Hutech</div>
          <div class="chat-status">
            <span class="status-dot"></span> Trực tuyến
          </div>
        </div>
      </div>
      <div class="chat-header-actions">
        <button class="chat-action-btn" onclick="clearChat()" title="Xóa lịch sử">
          <i class="far fa-trash-alt"></i>
        </button>
        <button class="chat-action-btn" onclick="toggleChat()" title="Đóng">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>

    @* Messages *@
    <div id="chatMessages" class="chat-messages">
      <div class="chat-msg assistant">
        <div class="msg-bubble">
          <p>Xin chào. Tôi là trợ lý AI của <strong>HutechStore</strong>.</p>
          <p>Tôi có thể giúp bạn tìm kiếm và so sánh các dòng sản phẩm cao cấp:</p>
          <ul class="mb-0 ps-3">
            <li>Tìm dòng điện thoại chơi game hiệu năng cao</li>
            <li>Đề xuất điện thoại chụp ảnh chuyên nghiệp</li>
            <li>Tư vấn cấu hình theo ngân sách cá nhân</li>
            <li>So sánh chi tiết iPhone và Samsung Galaxy</li>
          </ul>
        </div>
      </div>

      @* Quick replies gợi ý *@
      <div class="quick-replies" id="quickReplies">
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">Chơi game dưới 15tr</button>
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">Chụp ảnh tốt nhất</button>
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">Tầm giá 20-25 triệu</button>
        <button class="quick-reply-btn" onclick="sendQuickReply(this)">So sánh iPhone vs Samsung</button>
      </div>
    </div>

    @* Input *@
    <div class="chat-input-area">
      <div class="chat-input-wrap">
        <input type="text" id="chatInput" class="chat-input"
               placeholder="Nhập câu hỏi của bạn..."
               maxlength="500"
               onkeydown="if(event.key==='Enter')sendMessage()"/>
        <button class="chat-send-btn" onclick="sendMessage()" id="chatSendBtn">
          <i class="far fa-paper-plane"></i>
        </button>
      </div>
      <div class="chat-footer-note">
        Powered by Gemini AI · Dữ liệu thực từ HutechStore
      </div>
    </div>

  </div>
</div>
