@model HutechStore.ViewModels.DashboardViewModel
@{
  ViewData["Title"] = "Dashboard";
  Layout = "~/Views/Shared/_AdminLayout.cshtml";
  var statusMap = new Dictionary<string,(string,string)>{
    ["pending"]   =("Chờ xác nhận","warning"),
    ["confirmed"] =("Đã xác nhận","info"),
    ["shipping"]  =("Đang giao","primary"),
    ["delivered"] =("Đã nhận","success"),
    ["cancelled"] =("Đã hủy","danger"),
  };
}

@* ── STAT CARDS ── *@
<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon red"><i class="fas fa-box"></i></div>
      <div>
        <div class="stat-value">@Model.TotalOrders.ToString("N0")</div>
        <div class="stat-label">Tổng đơn hàng</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon blue"><i class="fas fa-mobile-alt"></i></div>
      <div>
        <div class="stat-value">@Model.TotalProducts</div>
        <div class="stat-label">Sản phẩm đang bán</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon green"><i class="fas fa-users"></i></div>
      <div>
        <div class="stat-value">@Model.TotalUsers.ToString("N0")</div>
        <div class="stat-label">Khách hàng</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon yellow"><i class="fas fa-chart-line"></i></div>
      <div>
        <div class="stat-value text-success" style="font-size:1.2rem">
          @Model.TotalRevenue.ToString("N0")₫
        </div>
        <div class="stat-label">Doanh thu (đã giao)</div>
      </div>
    </div>
  </div>
</div>

@* ── CHART + TOP PRODUCTS ── *@
<div class="row g-3 mb-4">

  @* Revenue Chart *@
  <div class="col-lg-8">
    <div class="admin-card">
      <div class="admin-card-header">
        <span>Doanh thu</span>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <select id="revenueYearSelect" class="form-select form-select-sm @(Model.ChartType == "month" ? "" : "d-none")" style="width:auto"
                  onchange="updateRevenueChart('month', this.value)">
            @foreach (var y in Model.AvailableYears)
            {
              @if (y == Model.SelectedYear) { <option value="@y" selected>@y</option> } else { <option value="@y">@y</option> }
            }
          </select>
          <div class="btn-group btn-group-sm">
            <button type="button" id="btn-chart-week" onclick="updateRevenueChart('week')" class="btn btn-revenue-toggle @(Model.ChartType=="week" ?"btn-primary":"btn-outline-secondary")">Tuần</button>
            <button type="button" id="btn-chart-month" onclick="updateRevenueChart('month')" class="btn btn-revenue-toggle @(Model.ChartType=="month" ?"btn-primary":"btn-outline-secondary")">Tháng</button>
            <button type="button" id="btn-chart-year" onclick="updateRevenueChart('year')" class="btn btn-revenue-toggle @(Model.ChartType=="year" ?"btn-primary":"btn-outline-secondary")">Năm</button>
          </div>
        </div>
      </div>
      <div class="admin-card-body">
        <div class="chart-wrap">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  @* Top Products *@
  <div class="col-lg-4">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <span>Top sản phẩm bán chạy</span>
      </div>
      <div class="admin-card-body p-0">
        @foreach (var (tp, i) in Model.TopProducts.Select((t, i) => (t, i + 1)))
        {
          <div class="d-flex align-items-center gap-3 px-3 py-2 border-bottom">
            <span class="top-rank top-rank-@(i <= 3 ? i.ToString() : "other")" style="flex-shrink: 0;">@i</span>
            <div class="flex-grow-1 min-width-0">
              <div class="fw-semibold small" style="word-break: break-word; line-height: 1.2;">@tp.Name</div>
              <div class="text-muted" style="font-size:.75rem">Đã bán: @tp.Sold</div>
            </div>
            <div class="fw-bold text-danger text-nowrap small ms-2" style="width: 110px; text-align: right; flex-shrink: 0;">@tp.Revenue.ToString("N0")₫</div>
          </div>
        }
        @if (!Model.TopProducts.Any())
        {
          <div class="text-center text-muted py-4 small">Chưa có dữ liệu</div>
        }
      </div>
    </div>
  </div>
</div>

@* ── RECENT ORDERS + STATUS BREAKDOWN ── *@
<div class="row g-3">

  @* Recent Orders *@
  <div class="col-lg-8">
    <div class="admin-card">
      <div class="admin-card-header">
        <span>Đơn hàng gần đây</span>
        <a asp-action="Orders" class="btn btn-outline-secondary btn-sm">Xem tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Mã đơn</th>
              <th>Khách hàng</th>
              <th>Tổng tiền</th>
              <th>Trạng thái</th>
              <th>Ngày đặt</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var o in Model.RecentOrders)
            {
              var (lbl, cls) = statusMap.GetValueOrDefault(o.Status, ("Không rõ", "secondary"));
              <tr>
                <td><span class="fw-bold text-danger">#@o.OrderNumber</span></td>
                <td>@(o.User?.Name ?? "Khách vãng lai")</td>
                <td class="fw-bold">@o.TotalAmount.ToString("N0")₫</td>
                <td><span class="status-badge status-@o.Status">@lbl</span></td>
                <td class="text-muted small">@o.CreatedAt.ToString("dd/MM/yyyy")</td>
              </tr>
            }
            @if (!Model.RecentOrders.Any())
            {
              <tr><td colspan="5" class="text-center text-muted py-3">Chưa có đơn hàng</td></tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  @* Status breakdown *@
  <div class="col-lg-4">
    <div class="admin-card">
      <div class="admin-card-header">
        <span>Theo trạng thái</span>
      </div>
      <div class="admin-card-body">
        <div class="chart-wrap" style="height:200px">
          <canvas id="statusChart"></canvas>
        </div>
        <div class="mt-3">
          @foreach (var s in Model.RevenueByStatus)
          {
            var (lbl, cls) = statusMap.GetValueOrDefault(s.Status, ("Không rõ", "secondary"));
            <div class="d-flex justify-content-between align-items-center py-1 border-bottom small">
              <span><span class="badge bg-@cls me-1">@lbl</span></span>
              <span class="fw-bold">@s.Count đơn</span>
            </div>
          }
        </div>
      </div>
    </div>
  </div>

</div>

@section Styles {
<style>
  .top-rank { width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.78rem; font-weight:800; flex-shrink:0; }
  .top-rank-1 { background:#ffd700; color:#000; }
  .top-rank-2 { background:#c0c0c0; color:#000; }
  .top-rank-3 { background:#cd7f32; color:#fff; }
  .top-rank-other { background:var(--ivory-warm); color:var(--text-secondary); }
</style>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Revenue bar chart
const revCtx = document.getElementById('revenueChart').getContext('2d');
window.myRevenueChart = new Chart(revCtx, {
  type: 'bar',
  data: {
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.Select(d => d.Label))),
    datasets: [{
      label: 'Doanh thu (₫)',
      data:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData.Select(d => d.Revenue))),
      backgroundColor: 'rgba(15, 42, 68, 0.75)',
      borderColor:     'rgba(15, 42, 68, 1)',
      borderWidth: 1,
      borderRadius: 6,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    animation: {
      duration: 400,
      easing: 'easeOutQuart'
    },
    scales: {
      y: {
        ticks: {
          callback: v => v >= 1e9 ? (v/1e9).toFixed(1)+'tỷ' : v >= 1e6 ? (v/1e6).toFixed(0)+'tr' : v
        },
        grid: { color: '#f0f0f0' }
      },
      x: { grid: { display: false } }
    }
  }
});

let currentChartType = '@Model.ChartType';
let currentYear = @Model.SelectedYear;

function updateRevenueChart(type, year) {
  currentChartType = type;
  if (year) currentYear = year;
  
  const yearSelect = document.getElementById('revenueYearSelect');
  if (type === 'month') {
    yearSelect.classList.remove('d-none');
  } else {
    yearSelect.classList.add('d-none');
  }

  document.querySelectorAll('.btn-revenue-toggle').forEach(btn => {
    btn.classList.remove('btn-primary');
    btn.classList.add('btn-outline-secondary');
  });
  const activeBtn = document.getElementById('btn-chart-' + type);
  if (activeBtn) {
    activeBtn.classList.remove('btn-outline-secondary');
    activeBtn.classList.add('btn-primary');
  }

  fetch(`/Admin/GetRevenueData?chartType=${type}&year=${currentYear}`)
    .then(res => res.json())
    .then(res => {
      if (res.success && window.myRevenueChart) {
        window.myRevenueChart.data.labels = res.labels;
        window.myRevenueChart.data.datasets[0].data = res.values;
        window.myRevenueChart.update();
      }
    })
    .catch(err => console.error("Lỗi khi tải dữ liệu biểu đồ:", err));
}

// Status donut chart
@{
  var statusColors = new Dictionary<string, string>{
    ["pending"]="rgba(255,193,7,.8)",["confirmed"]="rgba(13,202,240,.8)",
    ["shipping"]="rgba(13,110,253,.8)",["delivered"]="rgba(25,135,84,.8)",
    ["cancelled"]="rgba(15, 42, 68, 0.8)"
  };
}
const stCtx = document.getElementById('statusChart').getContext('2d');
new Chart(stCtx, {
  type: 'doughnut',
  data: {
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByStatus.Select(s => {
      return statusMap.ContainsKey(s.Status) ? statusMap[s.Status].Item1 : s.Status;
    }))),
    datasets: [{
      data:            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByStatus.Select(s => s.Count))),
      backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByStatus.Select(s => statusColors.GetValueOrDefault(s.Status, "rgba(108,117,125,.7)")))),
      borderWidth: 2,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } },
    cutout: '65%'
  }
});
</script>
}
