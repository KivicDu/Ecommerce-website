@model List<HutechStore.Models.Product>
@{
  ViewData["Title"] = "Quản lý sản phẩm";
  Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div class="text-muted small">Tổng: <strong>@ViewBag.Total</strong> sản phẩm</div>
  <a asp-action="ProductCreate" class="btn btn-danger">
    <i class="fas fa-plus me-2"></i>Thêm sản phẩm
  </a>
</div>

@* Search / Filter bar *@
<div class="admin-card mb-4">
  <div class="admin-card-body py-2">
    <form method="get" class="d-flex gap-2 flex-wrap align-items-center">
      <input type="text" name="search" class="form-control form-control-sm"
             placeholder="Tìm tên sản phẩm..." value="@ViewBag.Search" style="max-width:260px"/>
      <select name="brand" class="form-select form-select-sm" style="width:auto"
              onchange="this.form.submit()">
        <option value="">Tất cả hãng</option>
        @if(ViewBag.Brand=="Apple"){<option value="Apple" selected>Apple</option>}else{<option value="Apple">Apple</option>}
        @if(ViewBag.Brand=="Samsung"){<option value="Samsung" selected>Samsung</option>}else{<option value="Samsung">Samsung</option>}
      </select>
      <button type="submit" class="btn btn-danger btn-sm">
        <i class="fas fa-search me-1"></i>Tìm
      </button>
      @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()) || !string.IsNullOrEmpty(ViewBag.Brand?.ToString()))
      {
        <a href="?" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
      }
    </form>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:44px">#</th>
          <th style="width:52px">Ảnh</th>
          <th>Tên sản phẩm</th>
          <th>Hãng</th>
          <th>Giá</th>
          <th>Kho</th>
          <th>RAM / Chip</th>
          <th>Nổi bật</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var p in Model)
        {
          <tr>
            <td class="text-muted small">@p.Id</td>
            <td>
              <img src="@(p.Image ?? "/images/no-image.png")"
                   class="product-thumb"
                   onerror="this.onerror=null;this.src='/images/no-image.png'"
                   alt="@p.Name"/>
            </td>
            <td>
              <div class="fw-semibold small">@p.Name</div>
              <div class="text-muted" style="font-size:.73rem">@p.Category?.Name</div>
            </td>
            <td>
              @if (p.Brand == "Apple")
              {
                <span class="badge bg-dark"><i class="fab fa-apple"></i> Apple</span>
              }
              else
              {
                <span class="badge" style="background:#1428a0">Samsung</span>
              }
            </td>
            <td class="fw-bold text-danger">@p.Price.ToString("N0")₫</td>
            <td>
              @if (p.Stock <= 5)
              {
                <span class="text-danger fw-bold">@p.Stock</span>
              }
              else
              {
                <span>@p.Stock</span>
              }
            </td>
            <td class="small text-muted">
              @if (p.PhoneSpecs != null)
              {
                <span>@p.PhoneSpecs.RamGb GB · @p.PhoneSpecs.Chipset</span>
              }
            </td>
            <td>
              @if (p.Featured == 1)
              {
                <span class="badge bg-warning text-dark">⭐ Nổi bật</span>
              }
            </td>
            <td>
              @if (p.Status == 1)
              {
                <span class="status-badge status-delivered">Đang bán</span>
              }
              else
              {
                <span class="status-badge status-cancelled">Đã ẩn</span>
              }
            </td>
            <td>
              <div class="d-flex gap-1">
                <a asp-action="ProductEdit" asp-route-id="@p.Id"
                   class="btn btn-outline-primary btn-sm" title="Sửa">
                  <i class="fas fa-edit"></i>
                </a>
                <form asp-action="ProductDelete" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@p.Id"/>
                  <button type="submit" class="btn btn-outline-danger btn-sm" title="Ẩn"
                          onclick="return confirm('Ẩn sản phẩm @p.Name?')">
                    <i class="fas fa-eye-slash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        }
        @if (!Model.Any())
        {
          <tr><td colspan="10" class="text-center text-muted py-4">Không tìm thấy sản phẩm</td></tr>
        }
      </tbody>
    </table>
  </div>

  @* Pagination *@
  @if ((int)ViewBag.TotalPages > 1)
  {
    <div class="p-3 border-top">
      <nav><ul class="pagination pagination-sm justify-content-center mb-0">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
          <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
            <a class="page-link" href="?page=@i&search=@ViewBag.Search&brand=@ViewBag.Brand">@i</a>
          </li>
        }
      </ul></nav>
    </div>
  }
</div>
