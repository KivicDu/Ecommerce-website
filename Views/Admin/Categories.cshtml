@model List<HutechStore.Models.Category>
@{
  ViewData["Title"] = "Danh mục";
  Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row g-4">
  <div class="col-md-5">
    <div class="admin-card">
      <div class="admin-card-header">
        <span id="catFormTitle">Thêm danh mục</span>
      </div>
      <div class="admin-card-body">
        <form asp-action="CategorySave" method="post" id="catForm">
          @Html.AntiForgeryToken()
          <input type="hidden" name="Id" id="catId" value="0"/>
          <div class="mb-3">
            <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
            <input type="text" name="Name" id="catName" class="form-control" required placeholder="Ví dụ: iPhone"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả</label>
            <textarea name="Description" id="catDesc" class="form-control" rows="2"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Trạng thái</label>
            <select name="Status" id="catStatus" class="form-select">
              <option value="1">Hiện</option>
              <option value="0">Ẩn</option>
            </select>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
              <i class="fas fa-save me-2"></i>Lưu
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="resetCatForm()">Đặt lại</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-7">
    <div class="admin-card">
      <div class="admin-card-header">Danh sách danh mục (@Model.Count)</div>
      <div class="table-responsive">
        <table class="admin-table">
          <thead><tr><th>#</th><th>Tên</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
          <tbody>
            @foreach (var c in Model)
            {
              <tr>
                <td class="text-muted small">@c.Id</td>
                <td class="fw-semibold">@c.Name</td>
                <td class="text-muted small">@c.Description</td>
                <td>
                  <span class="status-badge @(c.Status==1?"status-delivered":"status-cancelled")">
                    @(c.Status == 1 ? "Hiện" : "Ẩn")
                  </span>
                </td>
                <td>
                  <button class="btn btn-outline-primary btn-sm"
                          onclick="editCat(@c.Id,'@c.Name.Replace("'","\\'")',`@(c.Description ?? "")`,@c.Status)">
                    <i class="fas fa-edit"></i>
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  function editCat(id, name, desc, status) {
    document.getElementById('catId').value     = id;
    document.getElementById('catName').value   = name;
    document.getElementById('catDesc').value   = desc;
    document.getElementById('catStatus').value = status;
    document.getElementById('catFormTitle').textContent = 'Sửa danh mục';
    document.getElementById('catForm').scrollIntoView({ behavior:'smooth' });
  }
  function resetCatForm() {
    document.getElementById('catId').value     = '0';
    document.getElementById('catName').value   = '';
    document.getElementById('catDesc').value   = '';
    document.getElementById('catStatus').value = '1';
    document.getElementById('catFormTitle').textContent = 'Thêm danh mục';
  }
</script>
}
