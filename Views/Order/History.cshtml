@model List<HutechStore.Models.Order>
@{ ViewData["Title"] = "Lịch sử đơn hàng"; }

@{
  var statusMap = new Dictionary<string, (string label, string cls)> {
    ["pending"]   = ("Chờ xác nhận", "warning"),
    ["confirmed"] = ("Đã xác nhận",  "info"),
    ["shipping"]  = ("Đang giao",    "primary"),
    ["delivered"] = ("Đã nhận",      "success"),
    ["cancelled"] = ("Đã hủy",       "danger"),
  };
}

<div class="container py-4">
  <h2 class="section-title mb-4"><i class="fas fa-box me-2"></i>Lịch sử đơn hàng</h2>

  @if (!Model.Any())
  {
    <div class="text-center py-5">
      <i class="fas fa-box-open fa-5x text-muted mb-3 d-block"></i>
      <h5 class="text-muted">Bạn chưa có đơn hàng nào</h5>
      <a asp-controller="Product" asp-action="Index" class="btn btn-danger mt-2">Mua sắm ngay</a>
    </div>
  }
  else
  {
    <div class="d-flex flex-column gap-3">
      @foreach (var order in Model)
      {
        var (label, cls) = statusMap.GetValueOrDefault(order.Status, ("Không rõ", "secondary"));
        <div class="order-history-card">
          <div class="order-history-header">
            <div>
              <span class="fw-bold text-danger">#@order.OrderNumber</span>
              <span class="ms-3 text-muted small">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <span class="badge bg-@cls">@label</span>
          </div>

          <div class="order-history-items">
            @foreach (var item in order.OrderItems.Take(3))
            {
              <div class="order-history-item">
                <img src="@(item.Product?.Image ?? "/images/no-image.png")"
                     alt="@item.ProductName"
                     onerror="this.onerror=null;this.src='/images/no-image.png'"/>
                <div class="flex-grow-1 min-width-0">
                  <div class="fw-semibold text-truncate small">@item.ProductName</div>
                  <div class="text-muted" style="font-size:.75rem">
                    x@item.Quantity · @item.Price.ToString("N0")₫
                  </div>
                </div>
              </div>
            }
            @if (order.OrderItems.Count > 3)
            {
              <div class="text-muted small ps-1">+@(order.OrderItems.Count - 3) sản phẩm khác</div>
            }
          </div>

          <div class="order-history-footer">
            <div>
              <span class="text-muted small">Tổng tiền:</span>
              <span class="fw-bold text-danger ms-2">@order.TotalAmount.ToString("N0")₫</span>
              <span class="text-muted small ms-2">· @order.PaymentMethod.ToUpper()</span>
            </div>
            <div class="d-flex gap-2">
              @if (order.Status == "pending")
              {
                <form asp-action="Cancel" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@order.Id"/>
                  <button type="submit" class="btn btn-outline-danger btn-sm"
                          onclick="return confirm('Xác nhận hủy đơn hàng?')">
                    Hủy đơn
                  </button>
                </form>
              }
              <a asp-action="Detail" asp-route-id="@order.Id"
                 class="btn btn-outline-secondary btn-sm">
                Xem chi tiết
              </a>
            </div>
          </div>
        </div>
      }
    </div>
  }
</div>

@section Styles {
<style>
  .order-history-card { background:#fff; border-radius:12px; border:1px solid var(--border-color); overflow:hidden; }
  .order-history-header { display:flex; justify-content:space-between; align-items:center; padding:.875rem 1.25rem; background:#f8f9fa; border-bottom:1px solid #f0f0f0; }
  .order-history-items { padding:.75rem 1.25rem; display:flex; flex-direction:column; gap:.5rem; }
  .order-history-item { display:flex; align-items:center; gap:.75rem; }
  .order-history-item img { width:44px; height:44px; border-radius:8px; object-fit:contain; background:#f8f9fa; padding:4px; border:1px solid #eee; flex-shrink:0; }
  .order-history-footer { padding:.875rem 1.25rem; border-top:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.5rem; }
</style>
}
